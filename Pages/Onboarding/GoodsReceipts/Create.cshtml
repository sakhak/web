@page
@model AssetManagement.Web.Pages.Onboarding.GoodsReceipts.CreateModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Receive Goods";
    var order = Model.Order;
    var heading = new HeadingModel { Title = "Receive Goods", Subtitle = $"{order.PoNumber} · {order.VendorName}" };
    heading.Actions.Add(new HeadingAction("Back to Order", "/Onboarding/PurchaseOrders/Details", new { id = order.Id }));
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<form method="post" novalidate>
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe blue"></div>
            <h4 class="form-card-title">Receipt Details</h4>
        </div>
        <div class="form-card-body">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label class="form-label-modern">Received Date</label>
                    <input type="date" name="Form.ReceivedDate" value="@(Model.Form.ReceivedDate?.ToString("yyyy-MM-dd"))" class="form-input-modern" />
                </div>
                <div>
                    <label class="form-label-modern">Received By</label>
                    <input name="Form.ReceivedBy" value="@Model.Form.ReceivedBy" class="form-input-modern" maxlength="100" />
                </div>
            </div>
            <div>
                <label class="form-label-modern">Remarks</label>
                <textarea name="Form.Remarks" class="form-textarea-modern" rows="2" maxlength="1000">@Model.Form.Remarks</textarea>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe indigo"></div>
            <h4 class="form-card-title">Quantities Received</h4>
        </div>
        <div class="form-card-body">
            <table class="modern-table line-table">
                <thead>
                    <tr>
                        <th>#</th><th>Description</th>
                        <th class="text-right">Ordered</th><th class="text-right">Already Received</th><th class="text-right">Remaining</th>
                        <th style="width:150px;">Receive Now</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < order.Lines.Count; i++)
                    {
                        var line = order.Lines[i];
                        var remaining = line.Quantity - line.ReceivedQuantity;
                        <tr>
                            <td><span class="cell-num">@line.LineNo</span></td>
                            <td>
                                <div class="cell-name">@line.Description</div>
                                <input type="hidden" name="Form.Lines[@i].PurchaseOrderLineId" value="@line.Id" />
                            </td>
                            <td class="text-right">@line.Quantity</td>
                            <td class="text-right">@line.ReceivedQuantity</td>
                            <td class="text-right">@remaining</td>
                            <td>
                                <input type="number" min="0" max="@remaining" name="Form.Lines[@i].QuantityReceived"
                                       value="@(Model.Form.Lines.Count > i ? Model.Form.Lines[i].QuantityReceived : 0)"
                                       class="form-input-modern" @(remaining == 0 ? "disabled" : "") />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="form-hint">Leave a line at 0 if nothing arrived for it. Partial deliveries are fine; receive the rest in another goods receipt.</p>
        </div>
    </div>

    <div class="form-actions">
        <a asp-page="/Onboarding/PurchaseOrders/Details" asp-route-id="@order.Id" class="btn-modern btn-secondary-modern">Cancel</a>
        <button type="submit" class="btn-modern btn-primary-modern">Record Goods Receipt</button>
    </div>
</form>
