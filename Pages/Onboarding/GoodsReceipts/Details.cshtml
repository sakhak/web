@page "{id:int}"
@model AssetManagement.Web.Pages.Onboarding.GoodsReceipts.DetailsModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = Model.Receipt.GrnNumber;
    ViewData["Tab"] = "grn";
    var grn = Model.Receipt;
    var heading = new HeadingModel { Title = grn.GrnNumber, Subtitle = $"Against {grn.PoNumber}" };
    heading.Actions.Add(new HeadingAction("Back to List", "/Onboarding/GoodsReceipts/Index"));
    heading.Actions.Add(new HeadingAction("Purchase Order", "/Onboarding/PurchaseOrders/Details", new { id = grn.PurchaseOrderId }));
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-stripe blue"></div>
        <h4 class="form-card-title">Receipt Information</h4>
    </div>
    <div class="form-card-body" style="padding:0;">
        <table class="info-table">
            <tr><td class="info-label">Purchase Order</td><td class="info-value">@grn.PoNumber</td></tr>
            <tr><td class="info-label">Received Date</td><td class="info-value">@grn.ReceivedDate.ToString("dd MMM yyyy")</td></tr>
            <tr><td class="info-label">Received By</td><td class="info-value">@grn.ReceivedBy</td></tr>
            @if (!string.IsNullOrEmpty(grn.Remarks))
            {
                <tr><td class="info-label">Remarks</td><td class="info-value">@grn.Remarks</td></tr>
            }
        </table>
    </div>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <p class="table-toolbar-title">Received Items</p>
            <p class="table-toolbar-sub">Tag each received unit with its pre-printed asset number to create the asset.</p>
        </div>
    </div>
    <div style="overflow-x:auto;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Description</th><th class="text-right">Unit Cost</th>
                    <th class="text-right">Received</th><th class="text-right">Tagged</th><th class="text-right">Left to Tag</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in grn.Lines)
                {
                    <tr>
                        <td><div class="cell-name">@line.Description</div></td>
                        <td class="text-right">@grn.Currency @line.UnitCost.ToString("N2")</td>
                        <td class="text-right">@line.QuantityReceived</td>
                        <td class="text-right">@line.TaggedQuantity</td>
                        <td class="text-right">@line.RemainingToTag</td>
                        <td class="text-right">
                            @if (Model.CanTag && line.RemainingToTag > 0)
                            {
                                <a asp-page="Tag" asp-route-grnId="@grn.Id" asp-route-lineId="@line.Id" class="toolbar-btn">Tag assets</a>
                            }
                            else if (line.RemainingToTag == 0)
                            {
                                <span class="status-badge in-use"><span class="dot"></span>All tagged</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
