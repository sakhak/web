@page
@model AssetManagement.Web.Pages.Onboarding.GoodsReceipts.IndexModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Goods Receipts";
    ViewData["Tab"] = "grn";
    var heading = new HeadingModel { Title = "Goods Receipts", Subtitle = "Record goods received against approved purchase orders, then tag them as assets." };
    if (Model.UserPermAccess.Contains("GRN_CREATE"))
        heading.Actions.Add(new HeadingAction("Receive Goods", "/Onboarding/PurchaseOrders/Index"));
}

<partial name="_Heading" model="heading" />
<partial name="_Tabs" />
<partial name="_Messages" />

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <p class="table-toolbar-title">Goods Receipts</p>
            <p class="table-toolbar-sub">@Model.TotalItems receipts</p>
        </div>
        <div class="table-toolbar-controls">
            <form method="get" style="display:flex; align-items:center; gap:8px;">
                <div class="toolbar-search">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="GRN or PO number…" style="width:190px;" />
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="Index" class="toolbar-btn" style="color:#DC2626; border-color:#FCA5A5;">Clear</a>
                }
            </form>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>GRN Number</th><th>PO Number</th><th>Received</th><th>By</th>
                    <th class="text-right">Units</th><th class="text-right">Tagged</th><th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Receipts.Count == 0)
                {
                    <tr><td colspan="7"><div class="empty-state"><p>No goods receipts found.</p></div></td></tr>
                }
                @foreach (var grn in Model.Receipts)
                {
                    <tr>
                        <td><span class="cell-mono">@grn.GrnNumber</span></td>
                        <td><a asp-page="/Onboarding/PurchaseOrders/Details" asp-route-id="@grn.PurchaseOrderId" class="cell-mono">@grn.PoNumber</a></td>
                        <td>@grn.ReceivedDate.ToString("dd MMM yyyy")</td>
                        <td>@grn.ReceivedBy</td>
                        <td class="text-right">@grn.Lines.Sum(l => l.QuantityReceived)</td>
                        <td class="text-right">@grn.Lines.Sum(l => l.TaggedQuantity)</td>
                        <td class="text-right"><a asp-page="Details" asp-route-id="@grn.Id" class="toolbar-btn">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="@((Model.PageNumber, Model.TotalPages, Model.TotalItems, "goods receipts",
        (Func<int, string>)(p => Url.Page("Index", new { pageNumber = p, pageSize = Model.PageSize, searchTerm = Model.SearchTerm })!)))" />
</div>
