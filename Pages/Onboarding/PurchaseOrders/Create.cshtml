@page
@model AssetManagement.Web.Pages.Onboarding.PurchaseOrders.CreateModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "New Purchase Order";
    ViewData["Profiles"] = Model.Profiles;
    ViewData["Categories"] = Model.Categories;
    var heading = new HeadingModel { Title = "New Purchase Order", Subtitle = "Create a draft order. It must be approved before goods can be received." };
    heading.Actions.Add(new HeadingAction("Back to List", "/Onboarding/PurchaseOrders/Index"));
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<form method="post" novalidate>
    <partial name="_PurchaseOrderForm" model="Model.Form" view-data="ViewData" />
    <div class="form-actions">
        <a asp-page="Index" class="btn-modern btn-secondary-modern">Cancel</a>
        <button type="submit" class="btn-modern btn-primary-modern">Save as Draft</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/onboarding.js" asp-append-version="true"></script>
}
