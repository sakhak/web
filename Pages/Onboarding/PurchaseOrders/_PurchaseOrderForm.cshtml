@model AssetManagement.Web.Models.PurchaseOrderForm
@using AssetManagement.Application.Contracts.Onboarding
@{
    var profiles = ViewData["Profiles"] as List<DepreciationProfileDto> ?? [];
    var categories = ViewData["Categories"] as List<AssetManagement.Application.Contracts.AssetCategoryDto> ?? [];
}

<input type="hidden" name="Form.Id" value="@Model.Id" />

<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-stripe blue"></div>
        <h4 class="form-card-title">Order Details</h4>
    </div>
    <div class="form-card-body">
        <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:16px; margin-bottom:16px;">
            <div>
                <label class="form-label-modern">Vendor <span style="color:#DC2626;">*</span></label>
                <input name="Form.VendorName" value="@Model.VendorName" class="form-input-modern" placeholder="e.g. Dell Technologies" maxlength="250" required />
            </div>
            <div>
                <label class="form-label-modern">Order Date</label>
                <input type="date" name="Form.OrderDate" value="@(Model.OrderDate?.ToString("yyyy-MM-dd"))" class="form-input-modern" />
            </div>
            <div>
                <label class="form-label-modern">Currency</label>
                <select name="Form.Currency" class="form-select-modern">
                    <option value="USD" selected="@(Model.Currency == "USD")">USD</option>
                    <option value="KHR" selected="@(Model.Currency == "KHR")">KHR</option>
                </select>
            </div>
        </div>
        <div>
            <label class="form-label-modern">Remarks</label>
            <textarea name="Form.Remarks" class="form-textarea-modern" rows="2" maxlength="1000">@Model.Remarks</textarea>
        </div>
    </div>
</div>

<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-stripe indigo"></div>
        <h4 class="form-card-title">Order Lines</h4>
    </div>
    <div class="form-card-body">
        <table class="modern-table line-table" id="lines-table" data-prefix="Form.Lines">
            <thead>
                <tr>
                    <th style="width:34%;">Description</th>
                    <th style="width:12%;">Category</th>
                    <th style="width:20%;">Depreciation Profile</th>
                    <th style="width:9%;">Qty</th>
                    <th style="width:12%;">Unit Cost</th>
                    <th class="text-right" style="width:11%;">Line Total</th>
                    <th style="width:2%;"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var line = Model.Lines[i];
                    <tr data-row>
                        <td><input name="Form.Lines[@i].Description" value="@line.Description" class="form-input-modern" maxlength="500" required /></td>
                        <td>
                            <select name="Form.Lines[@i].CategoryCode" class="form-select-modern">
                                <option value="">None</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Code" selected="@string.Equals(line.CategoryCode, c.Code, StringComparison.OrdinalIgnoreCase)">@c.Code - @c.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="Form.Lines[@i].DepreciationProfileId" class="form-select-modern">
                                <option value="">Default (5 years)</option>
                                @foreach (var p in profiles)
                                {
                                    <option value="@p.Id" selected="@(line.DepreciationProfileId == p.Id)">@p.Name (@p.UsefulLifeMonths m)</option>
                                }
                            </select>
                        </td>
                        <td><input type="number" min="1" name="Form.Lines[@i].Quantity" value="@line.Quantity" class="form-input-modern" data-qty required /></td>
                        <td><input type="number" min="0" step="0.01" name="Form.Lines[@i].UnitCost" value="@line.UnitCost" class="form-input-modern" data-cost required /></td>
                        <td class="text-right"><span data-line-total>0.00</span></td>
                        <td><button type="button" class="row-remove" data-remove title="Remove line">&times;</button></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-right"><strong>Total</strong></td>
                    <td class="text-right"><strong id="grand-total">0.00</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <button type="button" class="toolbar-btn" id="add-line" style="margin-top:12px;">+ Add line</button>

        <template id="line-template">
            <tr data-row>
                <td><input name="Form.Lines[__INDEX__].Description" class="form-input-modern" maxlength="500" required /></td>
                <td>
                    <select name="Form.Lines[__INDEX__].CategoryCode" class="form-select-modern">
                        <option value="">None</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Code">@c.Code - @c.Name</option>
                        }
                    </select>
                </td>
                <td>
                    <select name="Form.Lines[__INDEX__].DepreciationProfileId" class="form-select-modern">
                        <option value="">Default (5 years)</option>
                        @foreach (var p in profiles)
                        {
                            <option value="@p.Id">@p.Name (@p.UsefulLifeMonths m)</option>
                        }
                    </select>
                </td>
                <td><input type="number" min="1" name="Form.Lines[__INDEX__].Quantity" value="1" class="form-input-modern" data-qty required /></td>
                <td><input type="number" min="0" step="0.01" name="Form.Lines[__INDEX__].UnitCost" value="0" class="form-input-modern" data-cost required /></td>
                <td class="text-right"><span data-line-total>0.00</span></td>
                <td><button type="button" class="row-remove" data-remove title="Remove line">&times;</button></td>
            </tr>
        </template>
    </div>
</div>
