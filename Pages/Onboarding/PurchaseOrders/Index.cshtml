@page
@model AssetManagement.Web.Pages.Onboarding.PurchaseOrders.IndexModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Purchase Orders";
    ViewData["Tab"] = "po";
    var canCreate = Model.UserPermAccess.Contains("PO_CREATE");
    var heading = new HeadingModel { Title = "Purchase Orders", Subtitle = "Order assets from vendors before goods are received." };
    if (canCreate) heading.Actions.Add(new HeadingAction("New Purchase Order", "/Onboarding/PurchaseOrders/Create", null, true));
    string[] statuses = ["Draft", "Approved", "PartiallyReceived", "Received", "Cancelled"];
}

<partial name="_Heading" model="heading" />
<partial name="_Tabs" />
<partial name="_Messages" />

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <p class="table-toolbar-title">Purchase Orders</p>
            <p class="table-toolbar-sub">@Model.TotalItems orders</p>
        </div>
        <div class="table-toolbar-controls">
            <form method="get" style="display:flex; align-items:center; gap:8px;">
                <select name="status" class="toolbar-select" style="width:auto;" onchange="this.form.submit()">
                    <option value="">All statuses</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(Model.Status == s)">@OnboardingUi.StatusText(s)</option>
                    }
                </select>
                <div class="toolbar-search">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="PO number or vendor…" style="width:190px;" />
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.Status))
                {
                    <a asp-page="Index" class="toolbar-btn" style="color:#DC2626; border-color:#FCA5A5;">Clear</a>
                }
            </form>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>PO Number</th>
                    <th>Vendor</th>
                    <th>Order Date</th>
                    <th>Lines</th>
                    <th class="text-right">Total</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="7"><div class="empty-state"><p>No purchase orders found.</p></div></td></tr>
                }
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><span class="cell-mono">@order.PoNumber</span></td>
                        <td><div class="cell-name">@order.VendorName</div></td>
                        <td><span class="cell-text">@order.OrderDate.ToString("dd MMM yyyy")</span></td>
                        <td><span class="cell-text">@order.LineCount</span></td>
                        <td class="text-right"><span class="cell-text">@order.Currency @order.TotalAmount.ToString("N2")</span></td>
                        <td>
                            <span class="status-badge @OnboardingUi.StatusClass(order.Status)"><span class="dot"></span>@OnboardingUi.StatusText(order.Status)</span>
                        </td>
                        <td class="text-right">
                            <a asp-page="Details" asp-route-id="@order.Id" class="toolbar-btn">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="@((Model.PageNumber, Model.TotalPages, Model.TotalItems, "purchase orders",
        (Func<int, string>)(p => Url.Page("Index", new { pageNumber = p, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, status = Model.Status })!)))" />
</div>
