@page "{id:int}"
@model AssetManagement.Web.Pages.Onboarding.PurchaseOrders.EditModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Edit Purchase Order";
    ViewData["Profiles"] = Model.Profiles;
    ViewData["Categories"] = Model.Categories;
    var heading = new HeadingModel { Title = $"Edit {Model.PoNumber}", Subtitle = "Only draft orders can be edited." };
    heading.Actions.Add(new HeadingAction("Back to Order", "/Onboarding/PurchaseOrders/Details", new { id = Model.Form.Id }));
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<form method="post" novalidate>
    <partial name="_PurchaseOrderForm" model="Model.Form" view-data="ViewData" />
    <div class="form-actions">
        <a asp-page="Details" asp-route-id="@Model.Form.Id" class="btn-modern btn-secondary-modern">Cancel</a>
        <button type="submit" class="btn-modern btn-primary-modern">Save Changes</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/onboarding.js" asp-append-version="true"></script>
}
