@page
@model AssetManagement.Web.Pages.Assets.Delete

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Asset Management";
    ViewData["Page-PreTitle"] = "Overview";
}

<h2>Delete Asset</h2>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this asset?</h3>
    <p>This action cannot be undone.</p>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h4>Asset Details</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.AssetNumber)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.AssetNumber)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.AssetName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.AssetName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.Department)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.Department)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.Status)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.Status)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.Location)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.Location)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.PurchaseDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.PurchaseDate)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Asset.PurchaseCost)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Asset.PurchaseCost)
            </dd>
        </dl>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Asset.Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="/Assets/Index" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" 
             width="24" 
             height="24" 
             viewBox="0 0 24 24" 
             fill="none" 
             stroke="currentColor" 
             stroke-width="2" 
             stroke-linecap="round" 
             stroke-linejoin="round" 
             class="icon icon-tabler icons-tabler-outline icon-tabler-file-arrow-left">
             <path stroke="none" d="M0 0h24v24H0z" fill="none" />
             <path d="M14 3v4a1 1 0 0 0 1 1h4" />
             <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
             <path d="M15 15h-6" />
             <path d="M11.5 17.5l-2.5 -2.5l2.5 -2.5" />
         </svg>
        Back to List
    </a>
</form>