@page
@using static AssetManagement.Application.Common.Constants.ApplicationConstants
@using AssetManagement.Domain.Constants
@model AssetManagement.Web.Pages.Assets.IndexModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Asset Management";
    ViewData["Page-PreTitle"] = "Overview";

    var hasAssets = Model.Assets != null && Model.Assets.Any();
    var start = hasAssets ? (Model.PageNumber - 1) * Model.PageSize + 1 : 0;
    var end = hasAssets ? start + Model.Assets!.Count - 1 : 0;

    string StatusClass(string? s) => (s?.ToLower()) switch
    {
        "in use" => "in-use",
        "available" => "available",
        "in transit" => "in-transit",
        "maintenance" => "maintenance",
        "disposed" => "disposed",
        "retired" => "retired",
        _ => "disposed"
    };
}

<!-- Page heading -->
<div class="page-heading">
    <div class="breadcrumb-row">
        <span class="crumb muted">Overview</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
        <span class="crumb active">Asset Management</span>
    </div>
    <div class="page-heading-row">
        <div>
            <h1 class="page-title">Asset Management</h1>
            <p class="page-subtitle">Track, manage and audit all organizational assets.</p>
        </div>
        <div class="page-actions">
            <a href="#" class="btn-modern btn-secondary-modern">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Export
            </a>
            @if (Model.UserPermAccess.Contains(AssetFunctionKey.AssetCreate))
            {
                <a asp-page="/Assets/Create" class="btn-modern btn-primary-modern">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add New Asset
                </a>
            }
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards-grid">
    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </div>
            <span class="stat-badge blue">KHR</span>
        </div>
        <div class="stat-value">@Model.TotalAssets.TotalAssetsKhr?.ToString("N0")</div>
        <div class="stat-label">Total Assets (KHR)</div>
    </div>

    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon green">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </div>
            <span class="stat-badge green">USD</span>
        </div>
        <div class="stat-value">$@Model.TotalAssets.TotalAssetsUsd?.ToString("N0")</div>
        <div class="stat-label">Total Assets (USD)</div>
    </div>

    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon amber">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
            </div>
            <span class="stat-badge amber">+12%</span>
        </div>
        <div class="stat-value">@Model.TotalAssets.TotalAssetsCount</div>
        <div class="stat-label">Total Assets</div>
    </div>

    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon red">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
            </div>
            <span class="stat-badge red">Pending</span>
        </div>
        <div class="stat-value red">@Model.TotalAssets.TotalAssetsDisposal</div>
        <div class="stat-label">Total Disposal Assets</div>
    </div>
</div>

<!-- Table Card -->
<div class="table-card assets-table-card tabular-nums">
    <!-- Toolbar -->
    <div class="table-toolbar">
        <div>
            <div class="toolbar-heading-row">
                <h3 class="table-toolbar-title">Asset Items</h3>
                <span class="count-chip">@Model.TotalItems.ToString("N0")</span>
            </div>
            <p class="table-toolbar-sub">All registered assets across the organisation</p>
        </div>
        <div class="table-toolbar-controls">
            <!-- Page size -->
            <span class="toolbar-label">Show</span>
            <form method="get" id="pageSizeForm" style="display:inline;">
                <input type="hidden" name="pageNumber" value="1" />
                <select asp-for="PageSize" asp-items="Model.PageSizeOptions"
                        class="toolbar-select"
                        onchange="document.getElementById('pageSizeForm').submit();">
                </select>
            </form>
            <span class="toolbar-label">entries</span>

            <div class="toolbar-divider"></div>

            <!-- Search form -->
            <form method="get" id="searchForm" style="display:flex; align-items:center; gap:8px;">
                <input type="hidden" name="pageNumber" value="1" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <select name="searchBy" id="searchBy" class="toolbar-select" style="width:auto;">
                    <option value="" disabled selected>Search by</option>
                    <option value="AssetNumber" selected="@(Model.SearchBy == "AssetNumber")">Asset Number</option>
                    <option value="AssetName" selected="@(Model.SearchBy == "AssetName")">Asset Name</option>
                    <option value="Department" selected="@(Model.SearchBy == "Department")">Department</option>
                    <option value="Status" selected="@(Model.SearchBy == "Status")">Status</option>
                    <option value="Location" selected="@(Model.SearchBy == "Location")">Location</option>
                    <option value="Category" selected="@(Model.SearchBy == "Category")">Category</option>
                </select>

                <div class="toolbar-search">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    <input type="text" id="searchTermInput" placeholder="Search in table…"
                           value="@Model.SearchTerm" onkeydown="handleSearchSubmit(event)" style="width:190px;" />
                    <select id="statusDropdown" class="d-none" style="display:none; width:160px;">
                        <option value="">-- Select Status --</option>
                        <option value="Available" selected="@(Model.SearchTerm == "Available")">Available</option>
                        <option value="In Use" selected="@(Model.SearchTerm == "In Use")">In Use</option>
                        <option value="Maintenance" selected="@(Model.SearchTerm == "Maintenance")">Maintenance</option>
                        <option value="Retired" selected="@(Model.SearchTerm == "Retired")">Retired</option>
                    </select>
                </div>

                <input type="hidden" name="searchTerm" id="searchTermHidden" value="@Model.SearchTerm" />
                <button type="submit" class="toolbar-btn assets-search-btn">Search</button>

                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="/Assets/Index" class="toolbar-btn" style="color:#DC2626; border-color:#FCA5A5;">
                        Clear
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="table-scroll-wrap">
        <table class="modern-table assets-table">
            <thead class="sticky-thead">
                <tr>
                    <th style="width:40px;">
                        <input type="checkbox" class="check-modern" id="selectAllAssets" />
                    </th>
                    <th>No.</th>
                    <th>Asset Number</th>
                    <th>Asset Name</th>
                    <th>Department</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Location</th>
                    @if (Model.IsHavePermAccess)
                    {
                        <th class="text-right">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Assets != null && Model.Assets.Any())
                {
                    var i = 1;
                    foreach (var item in Model.Assets)
                    {
                        var menuId = $"menu-{item.Id}";
                        <tr>
                            <td>
                                <input type="checkbox" class="check-modern asset-checkbox" value="@item.Id" />
                            </td>
                            <td><span class="cell-num">@i</span></td>
                            <td><span class="cell-mono">@item.AssetNumber</span></td>
                            <td>
                                <div class="cell-name">@item.AssetName</div>
                            </td>
                            <td><span class="cell-text">@item.Department</span></td>
                            <td><span class="cell-text">@(item.CategoryId is { } cid ? Model.CategoryNames.GetValueOrDefault(cid, "-") : "-")</span></td>
                            <td>
                                <span class="status-badge @StatusClass(item.Status)">
                                    <span class="dot"></span>
                                    @item.Status
                                </span>
                            </td>
                            <td><span class="cell-text">@item.Location</span></td>
                            @if (Model.IsHavePermAccess)
                            {
                                <td class="text-right">
                                    <div class="action-dropdown">
                                        <button class="toolbar-btn" data-action-toggle="@menuId" type="button">
                                            Actions
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                                        </button>
                                        <div class="action-dropdown-menu" id="@menuId">
                                            @if (Model.UserPermAccess.Contains(AssetFunctionKey.AssetDetails))
                                            {
                                                <a class="action-dropdown-item" asp-page="/Assets/Details" asp-route-slug="@item.Slug">
                                                    Details
                                                </a>
                                            }
                                            @if (Model.UserPermAccess.Contains(AssetFunctionKey.AssetGenerateQR))
                                            {
                                                <a class="action-dropdown-item" asp-page="/Assets/QrCode" asp-route-id="@item.Id">
                                                    Generate QR Code
                                                </a>
                                            }
                                            @if (Model.UserPermAccess.Contains(AssetFunctionKey.AssetCreate))
                                            {
                                                <a class="action-dropdown-item" asp-page="/AssetMovements/Create" asp-route-slug="@item.Slug">
                                                    Movement
                                                </a>
                                            }
                                            @if (Model.UserPermAccess.Contains(AssetFunctionKey.AssetEdit))
                                            {
                                                <div class="action-dropdown-divider"></div>
                                                <a class="action-dropdown-item" asp-page="/Assets/Edit" asp-route-id="@item.Id">
                                                    Edit
                                                </a>
                                            }
                                            @if (Model.UserPermAccess.Contains(AssetFunctionKey.AssetDelete))
                                            {
                                                <a class="action-dropdown-item danger" asp-page="./Delete" asp-route-id="@item.Id">
                                                    Delete
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            }
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(Model.IsHavePermAccess ? 9 : 8)">
                            <div class="empty-state">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" /><rect x="9" y="3" width="6" height="4" rx="1" /></svg>
                                <p>No assets found.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="table-footer">
        <span class="table-footer-info">
            Showing <strong>@start</strong> to <strong>@end</strong> of <strong>@Model.TotalItems</strong> assets
        </span>
        <div class="pagination-modern">
            <a class="page-btn @(Model.PageNumber == 1 ? "disabled" : "")"
               asp-page="/Assets/Index"
               asp-route-pageNumber="@(Model.PageNumber - 1)"
               asp-route-pageSize="@Model.PageSize"
               asp-route-searchBy="@Model.SearchBy"
               asp-route-searchTerm="@Model.SearchTerm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
            </a>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a class="page-btn @(i == Model.PageNumber ? "active" : "")"
                   asp-page="/Assets/Index"
                   asp-route-pageNumber="@i"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchBy="@Model.SearchBy"
                   asp-route-searchTerm="@Model.SearchTerm">@i</a>
            }

            <a class="page-btn @(Model.PageNumber == Model.TotalPages ? "disabled" : "")"
               asp-page="/Assets/Index"
               asp-route-pageNumber="@(Model.PageNumber + 1)"
               asp-route-pageSize="@Model.PageSize"
               asp-route-searchBy="@Model.SearchBy"
               asp-route-searchTerm="@Model.SearchTerm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/assets/index.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Select all checkbox
            var selectAll = document.getElementById('selectAllAssets');
            var checkboxes = document.querySelectorAll('.asset-checkbox');

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(function (cb) { cb.checked = selectAll.checked; });
                });
                checkboxes.forEach(function (cb) {
                    cb.addEventListener('change', function () {
                        selectAll.checked = Array.from(checkboxes).every(function (c) { return c.checked; });
                    });
                });
            }

            // Search field type switching
            var searchBy = document.getElementById('searchBy');
            var input = document.getElementById('searchTermInput');
            var dropdown = document.getElementById('statusDropdown');
            var hidden = document.getElementById('searchTermHidden');

            function updateSearchControl() {
                if (!searchBy) return;
                if (searchBy.value === 'Status') {
                    input.style.display = 'none';
                    dropdown.style.display = '';
                    hidden.value = dropdown.value;
                } else {
                    input.style.display = '';
                    dropdown.style.display = 'none';
                    hidden.value = input.value;
                }
            }

            if (searchBy) {
                searchBy.addEventListener('change', updateSearchControl);
                if (input) input.addEventListener('input', function () { hidden.value = input.value; });
                if (dropdown) dropdown.addEventListener('change', function () {
                    hidden.value = dropdown.value;
                    document.getElementById('searchForm').submit();
                });
                updateSearchControl();
            }
        });

        function handleSearchSubmit(e) {
            if (e.key === 'Enter') {
                var hidden = document.getElementById('searchTermHidden');
                var input = document.getElementById('searchTermInput');
                if (hidden && input) hidden.value = input.value;
                document.getElementById('searchForm').submit();
            }
        }
    </script>
}
