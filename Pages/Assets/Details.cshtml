@page "{slug}"
@model AssetManagement.Web.Pages.Assets.Details
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Asset Details";
    ViewData["Page-PreTitle"] = "Asset Management";

    string StatusClass(string? s) => s?.ToLower() switch {
        "in use"      => "in-use",
        "available"   => "available",
        "in transit"  => "in-transit",
        "maintenance" => "maintenance",
        "disposed"    => "disposed",
        "retired"     => "retired",
        _ => "disposed"
    };

    int assetAgeDays   = (DateTime.Now - Model.Asset.PurchaseDate).Days;
    int assetAgeYears  = assetAgeDays / 365;
    int assetAgeMonths = (assetAgeDays % 365) / 30;

    string ageText = assetAgeYears > 0
        ? $"{assetAgeYears} {(assetAgeYears == 1 ? "year" : "years")}" + (assetAgeMonths > 0 ? $", {assetAgeMonths} mo" : "")
        : assetAgeMonths > 0 ? $"{assetAgeMonths} {(assetAgeMonths == 1 ? "month" : "months")}"
        : "< 1 month";

    bool hasImage = Model.Asset.File != null && Model.Asset.File.FileData?.Length > 0;
    string? imgBase64 = hasImage ? Convert.ToBase64String(Model.Asset.File!.FileData!) : null;
}

<!-- Page heading -->
<div class="page-heading">
    <div class="breadcrumb-row">
        <span class="crumb muted">Asset Management</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="crumb active">Asset Details</span>
    </div>
    <div class="page-heading-row">
        <div>
            <h1 class="page-title">@Model.Asset.AssetName</h1>
            <p class="page-subtitle" style="font-family:'DM Mono',monospace; font-size:12px;">@Model.Asset.AssetNumber</p>
        </div>
        <div class="page-actions">
            <a asp-page="/Assets/Index" class="btn-modern btn-secondary-modern">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Back to List
            </a>
            <a asp-page="/Assets/QrCode" asp-route-id="@Model.Asset.Id" class="btn-modern btn-secondary-modern">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    <line x1="14" y1="14" x2="17" y2="14"/><line x1="20" y1="14" x2="20" y2="14.01"/><line x1="14" y1="17" x2="14" y2="20"/><line x1="17" y1="17" x2="20" y2="17"/><line x1="20" y1="20" x2="20" y2="20.01"/>
                </svg>
                QR Code
            </a>
            <a asp-page="/Assets/Edit" asp-route-id="@Model.Asset.Id" class="btn-modern btn-primary-modern">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Edit
            </a>
            <button type="button" class="btn-modern btn-danger-modern"
                    onclick="document.getElementById('deleteModal').style.display='flex'">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                </svg>
                Delete
            </button>
        </div>
    </div>
</div>

<!-- Cover image -->
<div class="details-cover">
    <div class="details-cover-img">
        @if (hasImage)
        {
            <img src="data:image/jpeg;base64,@imgBase64" alt="@Model.Asset.AssetName" />
        }
        else
        {
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 8h.01"/><path d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6z"/>
                <path d="M3 16l5-5c.928-.893 2.072-.893 3 0l5 5"/><path d="M14 14l1-1c.928-.893 2.072-.893 3 0l3 3"/>
            </svg>
        }
        <div class="details-cover-change">
            <button type="button" class="btn-modern btn-secondary-modern"
                    onclick="document.getElementById('coverImageModal').style.display='flex'">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 8h.01"/><path d="M4 4m0 3a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7z"/>
                    <path d="M4 15l4-4a3 3 0 0 1 3 0l5 5"/><path d="M14 14l1-1a3 3 0 0 1 3 0l2 2"/>
                </svg>
                Change Image
            </button>
        </div>
    </div>

    <!-- Quick status bar -->
    <div style="padding:16px 24px; display:flex; align-items:center; gap:10px; border-top:1px solid #F1F5F9; flex-wrap:wrap;">
        <span class="status-badge @StatusClass(Model.Asset.Status)">
            <span class="dot"></span>@Model.Asset.Status
        </span>
        <span class="status-badge available" style="gap:6px;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"/></svg>
            @Model.Asset.Location
        </span>
        <span class="status-badge pending-approval" style="gap:6px;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21v-16a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></svg>
            @Model.Asset.Department
        </span>
    </div>
</div>

<!-- Details grid -->
<div class="details-grid">

    <!-- Left: Info table -->
    <div>
        <div class="form-card">
            <div class="form-card-header">
                <div class="form-card-stripe blue"></div>
                <h4 class="form-card-title">Asset Information</h4>
            </div>
            <div class="form-card-body" style="padding:0;">
                <table class="info-table">
                    <tr>
                        <td class="info-label">Asset Number</td>
                        <td class="info-value" style="font-family:'DM Mono',monospace;">@Model.Asset.AssetNumber</td>
                    </tr>
                    <tr>
                        <td class="info-label">Asset Name</td>
                        <td class="info-value">@Model.Asset.AssetName</td>
                    </tr>
                    <tr>
                        <td class="info-label">Department</td>
                        <td class="info-value">@Model.Asset.Department</td>
                    </tr>
                    <tr>
                        <td class="info-label">Location</td>
                        <td class="info-value">@Model.Asset.Location</td>
                    </tr>
                    <tr>
                        <td class="info-label">Status</td>
                        <td class="info-value">
                            <span class="status-badge @StatusClass(Model.Asset.Status)">
                                <span class="dot"></span>@Model.Asset.Status
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="info-label">Purchase Date</td>
                        <td class="info-value">@Model.Asset.PurchaseDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                    <tr>
                        <td class="info-label">Purchase Cost</td>
                        <td class="info-value" style="font-weight:700;">
                            @if (Model.Asset.Currency == "KHR")
                            {
                                <span>KHR @Model.Asset.PurchaseCost.ToString("N0")</span>
                            }
                            else
                            {
                                <span>$ @Model.Asset.PurchaseCost.ToString("N2")</span>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Asset.Description))
                    {
                        <tr>
                            <td class="info-label">Description</td>
                            <td class="info-value" style="color:#475569; font-weight:400;">@Model.Asset.Description</td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Right: sidebar cards -->
    <div>
        <!-- Financial summary -->
        <div class="side-card">
            <div class="side-card-header">Financial Summary</div>
            <div class="side-card-body">
                <div class="financial-row">
                    <span class="financial-label">Purchase Cost</span>
                    <span class="financial-value">
                        @(Model.Asset.Currency == "KHR"
                            ? $"KHR {Model.Asset.PurchaseCost:N0}"
                            : $"$ {Model.Asset.PurchaseCost:N2}")
                    </span>
                </div>
                <div class="financial-row">
                    <span class="financial-label">Currency</span>
                    <span class="financial-value">@Model.Asset.Currency</span>
                </div>
                <div class="financial-row">
                    <span class="financial-label">Purchase Date</span>
                    <span class="financial-value">@Model.Asset.PurchaseDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="financial-row">
                    <span class="financial-label">Asset Age</span>
                    <span class="financial-value">@ageText</span>
                </div>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="side-card">
            <div class="side-card-header">Quick Actions</div>
            <div class="side-card-body" style="padding:8px;">
                <ul class="action-list">
                    <li>
                        <a href="#" class="action-list-item">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/>
                            </svg>
                            Generate Report
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Maintenance/Records/Record" asp-route-assetNumber="@Model.Asset.AssetNumber" class="action-list-item">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 7h-3a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3"/><path d="M9 15h3l8.5-8.5a1.5 1.5 0 0 0-3-3l-8.5 8.5v3"/><path d="M16 5l3 3"/>
                            </svg>
                            Log Maintenance
                        </a>
                    </li>
                    <li>
                        <a asp-page="/AssetMovements/Create" asp-route-slug="@Model.Asset.Slug" class="action-list-item">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                            </svg>
                            Transfer Asset
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

</div>

<!-- Maintenance -->
<div class="form-card" style="margin-top:20px;">
    <div class="form-card-header">
        <div class="form-card-stripe amber"></div>
        <h4 class="form-card-title">Maintenance</h4>
    </div>
    <div class="form-card-body">
        <div style="display:flex; gap:8px; margin-bottom:12px;">
            @if (Model.CanManageMaintenance)
            {
                <a asp-page="/Maintenance/Schedules/Create" asp-route-assetNumber="@Model.Asset.AssetNumber" class="toolbar-btn">Add schedule</a>
            }
            @if (Model.CanCompleteMaintenance)
            {
                <a asp-page="/Maintenance/Records/Record" asp-route-assetNumber="@Model.Asset.AssetNumber" class="toolbar-btn">Record work</a>
            }
            <a asp-page="/Maintenance/Records/Index" asp-route-searchTerm="@Model.Asset.AssetNumber" class="toolbar-btn">Full history</a>
        </div>
        @if (Model.MaintenanceSchedules.Count == 0)
        {
            <p class="cell-text">No maintenance schedule for this asset.</p>
        }
        else
        {
            <table class="modern-table">
                <thead><tr><th>Schedule</th><th>Every</th><th>Next due</th><th>State</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.MaintenanceSchedules)
                    {
                        <tr>
                            <td>@s.Title</td>
                            <td>@s.IntervalMonths months</td>
                            <td>@s.NextDueDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (s.Status == AssetManagement.Domain.Constants.StatusCode.Active)
                                {
                                    <span class="status-badge @MaintenanceUi.StateClass(s.DueState)"><span class="dot"></span>@MaintenanceUi.StateText(s.DueState)</span>
                                }
                                else
                                {
                                    <span class="status-badge inactive"><span class="dot"></span>Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (Model.MaintenanceHistory.Count > 0)
        {
            <div class="info-label" style="margin:16px 0 6px;">Recent work</div>
            <table class="modern-table">
                <thead><tr><th>Date</th><th>Work</th><th>Type</th><th>Status</th><th class="text-right">Cost</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.MaintenanceHistory)
                    {
                        <tr>
                            <td>@((r.PerformedDate ?? r.PlannedDate).ToString("dd MMM yyyy"))</td>
                            <td><a asp-page="/Maintenance/Records/Details" asp-route-id="@r.Id">@r.Title</a></td>
                            <td>@r.Type</td>
                            <td>@MaintenanceUi.StatusText(r.Status)</td>
                            <td class="text-right">@(r.Cost is { } c ? $"{r.Currency} {c:N2}" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Depreciation -->
@if (Model.Depreciation is { } dep)
{
    <div class="form-card" style="margin-top:20px;">
        <div class="form-card-header">
            <div class="form-card-stripe green"></div>
            <h4 class="form-card-title">Depreciation</h4>
        </div>
        <div class="form-card-body">
            @if (TempData["Success"] is string depOk)
            {
                <div class="alert-success-modern">@depOk</div>
            }
            @if (TempData["Error"] is string depErr)
            {
                <div class="alert-danger-modern">@depErr</div>
            }
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:16px; margin-bottom:16px;">
                <div><div class="info-label">Profile</div><div class="info-value">@(dep.ProfileCode ?? "Default")@(dep.UsesDefaultLife ? " (no profile assigned)" : "")</div></div>
                <div><div class="info-label">Useful life</div><div class="info-value">@dep.UsefulLifeMonths months · salvage @dep.SalvagePercent.ToString("0.##")%</div></div>
                <div><div class="info-label">Depreciating from</div><div class="info-value">@dep.StartDate.ToString("dd MMM yyyy")</div></div>
                <div><div class="info-label">Annual charge</div><div class="info-value">@dep.Currency @dep.AnnualCharge.ToString("N2")</div></div>
                <div><div class="info-label">Cost</div><div class="info-value">@dep.Currency @dep.Cost.ToString("N2")</div></div>
                <div><div class="info-label">Accumulated</div><div class="info-value">@dep.Currency @dep.AccumulatedDepreciation.ToString("N2")</div></div>
                <div><div class="info-label">Book value</div><div class="info-value"><strong>@dep.Currency @dep.BookValue.ToString("N2")</strong>@(dep.FullyDepreciated ? " · fully depreciated" : "")</div></div>
            </div>

            <table class="modern-table schedule-table">
                <thead><tr><th>Year</th><th>Period end</th><th class="text-right">Charge</th><th class="text-right">Accumulated</th><th class="text-right">Book value</th></tr></thead>
                <tbody>
                    @foreach (var row in dep.Schedule)
                    {
                        <tr>
                            <td>@row.Year</td>
                            <td>@row.PeriodEnd.ToString("dd MMM yyyy")</td>
                            <td class="text-right">@row.Charge.ToString("N2")</td>
                            <td class="text-right">@row.Accumulated.ToString("N2")</td>
                            <td class="text-right">@row.BookValue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.CanManageDepreciation && Model.Profiles.Count > 0)
            {
                <form method="post" asp-page-handler="AssignProfile" asp-route-slug="@Model.Asset.Slug" style="display:flex; align-items:flex-end; gap:12px; margin-top:16px; flex-wrap:wrap;">
                    <div style="min-width:260px;">
                        <label class="form-label-modern">Assign depreciation profile</label>
                        <select name="profileId" class="form-select-modern">
                            @foreach (var p in Model.Profiles)
                            {
                                <option value="@p.Id" selected="@(dep.ProfileId == p.Id)">@p.Name · @p.UsefulLifeMonths months</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label-modern">Start date</label>
                        <input type="date" name="startDate" value="@dep.StartDate.ToString("yyyy-MM-dd")" class="form-input-modern" />
                    </div>
                    <button type="submit" class="btn-modern btn-primary-modern">Apply</button>
                </form>
            }
        </div>
    </div>
}

<!-- ── Modals (Bootstrap-compatible, shown via display:flex overlay) ── -->

<!-- Cover Image Upload Modal -->
<div id="coverImageModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,.4); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:12px; width:440px; max-width:95vw; box-shadow:0 20px 60px rgba(15,23,42,.2); overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #F1F5F9; display:flex; align-items:center; justify-content:space-between;">
            <span style="font-size:15px; font-weight:700; color:#0F172A;">Change Cover Image</span>
            <button type="button" onclick="document.getElementById('coverImageModal').style.display='none'"
                    style="background:none; border:none; cursor:pointer; color:#94A3B8; font-size:20px; line-height:1;">&times;</button>
        </div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="UploadCoverImage" asp-route-id="@Model.Asset.Id">
            <div style="padding:24px;">
                <label class="form-label-modern">Select new cover image</label>
                <input type="file" name="CoverImage" accept="image/*" required class="form-input-modern" style="padding:6px 12px; height:auto;" />
                <p class="form-hint">Recommended: 1200×300px · Max 5MB</p>
            </div>
            <div style="padding:16px 24px; border-top:1px solid #F1F5F9; display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="btn-modern btn-secondary-modern"
                        onclick="document.getElementById('coverImageModal').style.display='none'">Cancel</button>
                <button type="submit" class="btn-modern btn-primary-modern">Upload</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete confirmation modal -->
<div id="deleteModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,.4); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:12px; width:380px; max-width:95vw; box-shadow:0 20px 60px rgba(15,23,42,.2); overflow:hidden;">
        <div style="padding:24px;">
            <div style="font-size:15px; font-weight:700; color:#0F172A; margin-bottom:8px;">Delete Asset?</div>
            <p style="font-size:13px; color:#64748B; margin:0;">This will permanently remove <strong>@Model.Asset.AssetName</strong> and all associated data. This cannot be undone.</p>
        </div>
        <div style="padding:16px 24px; border-top:1px solid #F1F5F9; display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="btn-modern btn-secondary-modern"
                    onclick="document.getElementById('deleteModal').style.display='none'">Cancel</button>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Asset.Id" style="display:inline;">
                <button type="submit" class="btn-modern btn-danger-modern" style="background:#DC2626; color:white; border-color:#DC2626;">
                    Yes, delete
                </button>
            </form>
        </div>
    </div>
</div>
