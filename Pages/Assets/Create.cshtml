@page
@model AssetManagement.Web.Pages.Assets.CreateModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Add New Asset";
    ViewData["Page-PreTitle"] = "Asset Management";
}

<!-- Page heading -->
<div class="page-heading">
    <div class="breadcrumb-row">
        <span class="crumb muted">Asset Management</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="crumb active">Add New Asset</span>
    </div>
    <div class="page-heading-row">
        <div>
            <h1 class="page-title">Add New Asset</h1>
            <p class="page-subtitle">Register a new organizational asset.</p>
        </div>
        <div class="page-actions">
            <a asp-page="/Assets/Index" class="btn-modern btn-secondary-modern">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Back to List
            </a>
        </div>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="alert-danger-modern"></div>

<form method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="All" class="alert-danger-modern" style="display:none;"></div>

    <!-- Asset Identity -->
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe blue"></div>
            <h4 class="form-card-title">Asset Identity</h4>
        </div>
        <div class="form-card-body">
            <div style="display:grid; grid-template-columns:1fr 2fr; gap:16px;">
                <div>
                    <label class="form-label-modern" asp-for="Asset.AssetNumber">Asset Number <span style="color:#DC2626;">*</span></label>
                    <input asp-for="Asset.AssetNumber" class="form-input-modern" placeholder="e.g. AST-2024-001" required />
                    <span asp-validation-for="Asset.AssetNumber" class="form-error"></span>
                </div>
                <div>
                    <label class="form-label-modern" asp-for="Asset.AssetName">Asset Name <span style="color:#DC2626;">*</span></label>
                    <input asp-for="Asset.AssetName" class="form-input-modern" placeholder="e.g. Dell Latitude 7440" required />
                    <span asp-validation-for="Asset.AssetName" class="form-error"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Asset Details -->
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe indigo"></div>
            <h4 class="form-card-title">Asset Details</h4>
        </div>
        <div class="form-card-body">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label class="form-label-modern" asp-for="Asset.Department">Department</label>
                    <input asp-for="Asset.Department" class="form-input-modern" placeholder="e.g. IT Department" />
                    <span asp-validation-for="Asset.Department" class="form-error"></span>
                </div>
                <div>
                    <label class="form-label-modern" asp-for="Asset.Status">Status</label>
                    <select asp-for="Asset.Status" class="form-select-modern">
                        <option value="">-- Select Status --</option>
                        <option value="Available">Available</option>
                        <option value="In Use">In Use</option>
                        <option value="Maintenance">Maintenance</option>
                        <option value="Retired">Retired</option>
                    </select>
                    <span asp-validation-for="Asset.Status" class="form-error"></span>
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label class="form-label-modern" asp-for="Asset.Location">Location</label>
                    <input asp-for="Asset.Location" class="form-input-modern" placeholder="e.g. LOLC Head Office" />
                    <span asp-validation-for="Asset.Location" class="form-error"></span>
                </div>
                <div>
                    <label class="form-label-modern" asp-for="Asset.CategoryId">Category</label>
                    <select asp-for="Asset.CategoryId" asp-items="Model.CategoryItems" class="form-select-modern">
                        <option value="">-- No category --</option>
                    </select>
                </div>
                <div>
                    <label class="form-label-modern" asp-for="Asset.PurchaseDate">Purchase Date</label>
                    <div class="input-with-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <input type="text" asp-for="Asset.PurchaseDate" class="form-input-modern"
                               id="datepicker-create" placeholder="Select a date" autocomplete="off" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Asset Image -->
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe violet"></div>
            <h4 class="form-card-title">Asset Image</h4>
        </div>
        <div class="form-card-body">
            <label class="form-label-modern" asp-for="AssetImage">Upload Image</label>
            <span asp-validation-for="AssetImage" class="form-error"></span>

            <label class="upload-zone" for="assetImage">
                <input asp-for="AssetImage" type="file" id="assetImage" name="AssetImage" accept="image/*" />
                <div class="upload-zone-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <div class="upload-zone-label">Click to upload or drag & drop</div>
                <div class="upload-zone-hint">Max 5MB · JPG, PNG, GIF</div>
            </label>

            <div id="fileInfo" style="display:none; margin-top:10px; display:flex; align-items:center; gap:8px;">
                <span class="status-badge available" id="fileName"></span>
                <span class="status-badge in-transit" id="fileSize"></span>
            </div>

            <div id="imagePreviewContainer" style="display:none; margin-top:14px;">
                <label class="form-label-modern">Preview</label>
                <div class="img-preview-wrap">
                    <img id="imagePreview" src="#" alt="Preview" />
                </div>
            </div>
        </div>
    </div>

    <!-- Financial & Description -->
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe green"></div>
            <h4 class="form-card-title">Financial &amp; Description</h4>
        </div>
        <div class="form-card-body">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label class="form-label-modern" asp-for="Asset.PurchaseCost">Purchase Cost</label>
                    <div class="input-group-modern">
                        <input asp-for="Asset.PurchaseCost" class="form-input-modern" placeholder="0.00" />
                        <select asp-for="Asset.Currency" class="form-select-modern">
                            <option value="USD">USD ($)</option>
                            <option value="KHR">KHR (៛)</option>
                        </select>
                    </div>
                    <span asp-validation-for="Asset.PurchaseCost" class="form-error"></span>
                </div>
                <div>
                    <label class="form-label-modern" asp-for="Asset.Description">Description</label>
                    <textarea asp-for="Asset.Description" class="form-textarea-modern" placeholder="Brief description of the asset…"></textarea>
                    <span asp-validation-for="Asset.Description" class="form-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-page="/Assets/Index" class="btn-modern btn-secondary-modern">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Cancel
        </a>
        <button type="submit" class="btn-modern btn-primary-modern">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Create Asset
        </button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="~/lib/tabler/dist/libs/litepicker/dist/litepicker.js" asp-append-version="true"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Date picker
        if (window.Litepicker) {
            new Litepicker({ element: document.getElementById('datepicker-create') });
        }

        // Image preview
        var fileInput = document.getElementById('assetImage');
        if (fileInput) {
            fileInput.addEventListener('change', function () {
                var file = this.files[0];
                var fileInfo = document.getElementById('fileInfo');
                var fileName = document.getElementById('fileName');
                var fileSize = document.getElementById('fileSize');
                var previewContainer = document.getElementById('imagePreviewContainer');
                var preview = document.getElementById('imagePreview');

                if (file) {
                    fileName.textContent = file.name;
                    var size = file.size < 1024 ? file.size + ' B'
                             : file.size < 1048576 ? (file.size / 1024).toFixed(1) + ' KB'
                             : (file.size / 1048576).toFixed(1) + ' MB';
                    fileSize.textContent = size;
                    fileInfo.style.display = 'flex';

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        previewContainer.style.display = '';
                    };
                    reader.readAsDataURL(file);
                } else {
                    fileInfo.style.display = 'none';
                    previewContainer.style.display = 'none';
                }
            });
        }
    });
    </script>
}
