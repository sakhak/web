@page
@model AssetManagement.Web.Pages.Assets.QrCode
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "QR Code for Asset: " + Model.Asset?.AssetName;
    ViewData["Page-PreTitle"] = "Overview";
}

<div class="row g-3">
    <!-- Asset Information Card -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Asset Information</h3>
            </div>
            <div class="card-body">
                <h5 class="card-title">@Model.Asset.AssetName</h5>
                <div class="table-responsive mt-3">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th class="ps-0" 
                                    style="width: 40%;">
                                    Asset Number
                                </th>
                                <td>@Model.Asset.AssetNumber</td>
                            </tr>
                            <tr>
                                <th class="ps-0">Department</th>
                                <td>@Model.Asset.Department</td>
                            </tr>
                            <tr>
                                <th class="ps-0">Description</th>
                                <td>@Model.Asset.Description</td>
                            </tr>
                            <tr>
                                <th class="ps-0">Status</th>
                                <td>
                                    <span class="badge text-bg-@(Model.Asset.Status == "Active" ? "success" :
                                                                                                  Model.Asset.Status == "Maintenance" ? "warning" :
                                                                                                  Model.Asset.Status == "Out of Service" ? "danger" : "secondary")">
                                        @Model.Asset.Status
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- QR Code Card -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">QR Code</h3>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div class="qr-container mb-3">
                    <img src="data:image/png;base64,@Model.QrCodeImageBase64"
                         alt="QR Code for Asset @Model.Asset.AssetNumber"
                         class="img-fluid"
                         style="max-width: 100%; height: auto;" />
                </div>
                <div class="mt-3">
                    <a href="data:image/png;base64,@Model.QrCodeImageBase64"
                       download="Asset_@(Model.Asset.AssetNumber).png"
                       class="btn btn-success">
                        <svg xmlns="http://www.w3.org/2000/svg" 
                             width="24" 
                             height="24" 
                             viewBox="0 0 24 24" 
                             fill="none" 
                             stroke="currentColor" 
                             stroke-width="2" 
                             stroke-linecap="round" 
                             stroke-linejoin="round" 
                             class="icon icon-tabler icons-tabler-outline icon-tabler-download me-1">
                             <path stroke="none" 
                                   d="M0 0h24v24H0z" 
                                   fill="none" />
                             <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
                             <path d="M7 11l5 5l5 -5" />
                             <path d="M12 4l0 12" />
                        </svg> 
                        Download QR Code
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-page="/Assets/Index" 
       class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" 
             width="24" 
             height="24" 
             viewBox="0 0 24 24" 
             fill="none" 
             stroke="currentColor" 
             stroke-width="2" 
             stroke-linecap="round" 
             stroke-linejoin="round" 
             class="icon icon-tabler icons-tabler-outline icon-tabler-file-arrow-left me-1">
             <path stroke="none" 
                   d="M0 0h24v24H0z" 
                   fill="none" />
             <path d="M14 3v4a1 1 0 0 0 1 1h4" />
             <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
             <path d="M15 15h-6" />
             <path d="M11.5 17.5l-2.5 -2.5l2.5 -2.5" />
         </svg>
         Back to List
    </a>
</div>
