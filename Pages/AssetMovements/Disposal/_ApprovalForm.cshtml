@model AssetManagement.Web.Models.ApprovalModel.DisposalApproval
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form method="post" asp-page-handler="ApprovalDisopsal" id="approveForm">
    @Html.AntiForgeryToken()

    <!-- Hidden Id to bind -->
    <input type="hidden" name="Id" id="Id" value="@Model?.Id" />

    <div class="mb-3">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label asp-for="Approved" class="form-label"></label>
            </div>
            <div class="col-md-9">
                <select asp-for="Approved"
                        class="form-select"
                        name="Approved"
                        id="Approved"
                        style=""
                        required>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason"
                  class="form-control"
                  rows="3"
                  maxlength="500"
                  placeholder="Enter reason (max 500 characters)..."></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="d-flex">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary ms-auto">
            Submit
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
