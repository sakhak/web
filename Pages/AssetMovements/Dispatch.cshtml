@page
@model AssetManagement.Web.Pages.AssetMovements.DispatchModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Asset Management";
    ViewData["Page-PreTitle"] = "Overview";
}

<h2>Dispatch Asset</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Movement Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Asset:</dt>
                    <dd class="col-sm-8">@Model.Asset.AssetName (@Model.Asset.AssetNumber)</dd>

                    <dt class="col-sm-4">Movement Type:</dt>
                    <dd class="col-sm-8">@Model.AssetMovement.MovementType</dd>

                    <dt class="col-sm-4">From:</dt>
                    <dd class="col-sm-8">@Model.AssetMovement.SourceLocation</dd>

                    <dt class="col-sm-4">To:</dt>
                    <dd class="col-sm-8">@Model.AssetMovement.DestinationLocation</dd>

                    <dt class="col-sm-4">Current Custodian:</dt>
                    <dd class="col-sm-8">@Model.AssetMovement.CurrentCustodian</dd>

                    @if (!string.IsNullOrEmpty(Model.AssetMovement.NewCustodian))
                    {
                        <dt class="col-sm-4">New Custodian:</dt>
                        <dd class="col-sm-8">@Model.AssetMovement.NewCustodian</dd>
                    }

                    <dt class="col-sm-4">Request Date:</dt>
                    <dd class="col-sm-8">@Model.AssetMovement.RequestDate?.ToString("yyyy-MM-dd")</dd>

                    @if (Model.AssetMovement.ExpectedReturnDate.HasValue)
                    {
                        <dt class="col-sm-4">Expected Return:</dt>
                        <dd class="col-sm-8">@Model.AssetMovement.ExpectedReturnDate.Value.ToString("yyyy-MM-dd")</dd>
                    }

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        <span class="badge text-bg-info">@Model.AssetMovement.Status</span>
                    </dd>
                </dl>
            </div>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AssetMovement.Id" />

            <div class="form-group mb-3">
                <label asp-for="Comments" class="form-label">Dispatch Comments</label>
                <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Dispatch Asset</button>
                <a asp-page="./Details" asp-route-id="@Model.AssetMovement.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Tracking QR Code</h5>
            </div>
            <div class="card-body text-center">
                <p class="mb-2">Scan this code to track the asset movement</p>
                <img src="data:image/png;base64,@Model.QrCodeImageBase64" class="img-fluid" style="max-width: 250px;" />
                <p class="mt-3">Tracking Code: <strong>@Model.AssetMovement.TrackingCode</strong></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
