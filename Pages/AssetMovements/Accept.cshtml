@page
@model AssetManagement.Web.Pages.AssetMovements.Accept
@{
    Layout = "Shared/_Layout";
}

<h2>Accept Asset Delivery</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Scan QR Code or Enter Tracking Code</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Search">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="TrackingCode" class="form-label">Tracking Code</label>
                        <div class="input-group">
                            <input asp-for="TrackingCode" class="form-control" 
                                                          placeholder="Enter or scan the tracking code" />
                            <button type="submit" 
                                    class="btn btn-primary">Search</button>
                        </div>
                        <span asp-validation-for="TrackingCode" class="text-danger"></span>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.SearchPerformed && Model.AssetMovement == null)
        {
            <div class="alert alert-warning mt-3">
                <strong>Asset not found!</strong> No dispatched asset was found with the tracking code provided.
            </div>
        }
    </div>

    @if (Model.AcceptanceCompleted)
    {
        <div class="col-12 mt-4">
            <div class="alert alert-success">
                <h4 class="alert-heading">Asset Accepted Successfully!</h4>
                <p>The asset has been accepted and records have been updated.</p>
                <hr />
                <p class="mb-0">
                    Asset <strong>@Model.Asset.AssetName</strong> is now marked as
                    @if (Model.AssetMovement.MovementType == "Transfer")
                    {
                        <span>in use at @Model.AssetMovement.DestinationLocation</span>
                    }
                    else if (Model.AssetMovement.MovementType == "Repair")
                    {
                        <span>under maintenance</span>
                    }
                    else if (Model.AssetMovement.MovementType == "Disposal")
                    {
                        <span>pending disposal</span>
                    }
                </p>
            </div>

            <div class="mt-3">
                <a asp-page="/Assets/Index" class="btn btn-primary">Asset List</a>
                @if (Model.AssetMovement.MovementType == "Repair")
                {
                    <a asp-page="/RepairRecords/Index" class="btn btn-info">Repair Records</a>
                }
                else if (Model.AssetMovement.MovementType == "Disposal")
                {
                    <a asp-page="/DisposalRecords/Index" class="btn btn-info">Disposal Records</a>
                }
            </div>
        </div>
    }

    @if (Model.SearchPerformed && 
         Model.AssetMovement != null && 
         !Model.AcceptanceCompleted)
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5>Asset Found - Ready for Acceptance</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Asset:</dt>
                        <dd class="col-sm-8">@Model.Asset.AssetName (@Model.Asset.AssetNumber)</dd>

                        <dt class="col-sm-4">Movement Type:</dt>
                        <dd class="col-sm-8">@Model.AssetMovement.MovementType</dd>

                        <dt class="col-sm-4">From:</dt>
                        <dd class="col-sm-8">@Model.AssetMovement.SourceLocation</dd>

                        <dt class="col-sm-4">To:</dt>
                        <dd class="col-sm-8">@Model.AssetMovement.DestinationLocation</dd>

                        <dt class="col-sm-4">Dispatched On:</dt>
                        <dd class="col-sm-8">@Model.AssetMovement.DispatchDate?.ToString("yyyy-MM-dd")</dd>
                    </dl>

                    <form method="post" asp-page-handler="Accept">
                        <input type="hidden" asp-for="TrackingCode" />

                        <div class="form-group mb-3">
                            <label asp-for="AcceptedBy" class="form-label">Your Name</label>
                            <input asp-for="AcceptedBy" class="form-control" required />
                            <span asp-validation-for="AcceptedBy" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Comments" class="form-label">Acceptance Comments</label>
                            <textarea asp-for="Comments" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Comments" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-success">Accept Asset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}