@page
@model AssetManagement.Web.Pages.AssetMovements.RepairUpdateModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Repair Status";
}

<!-- Use container-fluid for full width -->
<div class="container-fluid p-0">
    <div class="card w-100">
        <div class="card-header">
            <h3 class="card-title">Edit Repair Status</h3>
        </div>
        <div class="card-body">
            <form method="post"
                  class="needs-validation" novalidate>
                <input type="hidden"
                       asp-for="RepairRecord.Id" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger rounded p-2 mb-3 bg-danger-subtle"></div>
                <input type="hidden"
                       asp-for="RepairRecord.AssetId" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger rounded p-2 mb-3 bg-danger-subtle"></div>
                <input type="hidden"
                       asp-for="StaffId" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger rounded p-2 mb-3 bg-danger-subtle"></div>

                <!-- Asset Identity Section -->
                <div class="card mb-4">
                    <div class="card-status-top bg-primary"></div>
                    <div class="card-header">
                        <h4 class="card-title">Asset Identity</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="RepairRecord.RepairStatus" class="form-label"></label>
                                    <select asp-for="RepairRecord.RepairStatus" class="form-select">
                                        <option value="Pending">Pending</option>
                                        <option value="Under Review">Under Review</option>
                                        <option value="Approved">Approved</option>
                                        <option value="In Repair">In Repair</option>
                                        <option value="Completed">Completed</option>
                                        <option value="On Hold">On Hold</option>
                                        <option value="Returned">Returned</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                    <span asp-validation-for="RepairRecord.RepairStatus" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label"
                                       asp-for="RepairRecord.Notes"></label>
                                <input asp-for="RepairRecord.Notes"
                                       class="form-control"
                                       placeholder="Remark" required />
                                <span asp-validation-for="RepairRecord.Notes"
                                      class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <button id="btnUpdate"
                            type="submit"
                            name="RepairRecord.Id"
                            value="@Model.RepairRecord.Id"
                            class="btn btn-primary")>
                            Save Changed
                    </button>
                    <a asp-page="/AssetMovements/Details" asp-route-slug="@Model.RepairRecord?.AssetMovementId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>