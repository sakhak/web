@model AssetManagement.Web.Models.ApprovalModel.SendToApprove
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form method="post" asp-page-handler="SendToApprove" id="sendToApproveForm">
    @Html.AntiForgeryToken()

    <!-- Hidden Id to bind -->
    <input type="hidden" name="Id" id="Id" value="@Model?.Id" />

    <div class="mb-3">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label asp-for="Authorizer" class="form-label"></label>
            </div>
            <div class="col-md-9">
                <select asp-for="Authorizer"
                        class="form-select"
                        name="Authorizer"
                        id="Authorizer"
                        style=""
                        required>
                    @* ---- Approval user will change later ---- *@
                    <option value="angtheara">Ang Theara</option>
                    <option value="sunchengchhay">Sun Chengchhay</option>
                    <option value="sakuonchanna">Sakuon Channa</option>
                </select>
            </div>
        </div>
    </div>
    
    <div class="d-flex">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary ms-auto">
            Submit
        </button>
    </div>


</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
