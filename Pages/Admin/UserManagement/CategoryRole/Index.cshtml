@page
@using System.Text.Json
@model AssetManagement.Web.Pages.Admin.UserManagement.CategoryRole.IndexModel
@{
    Layout = "_Layout";

    string categoryRolesJson = string.Empty;
    string rolesJson = string.Empty;

    if (Model.CategoryRoles != null && 
        Model.Roles != null)
    {
        categoryRolesJson = JsonSerializer.Serialize(Model.CategoryRoles);
        rolesJson = JsonSerializer.Serialize(Model.Roles);
    }
}
<div id="toast-message">
</div>

<div class="modal fade" 
     id="confirmModal" 
     tabindex="-1" 
     aria-labelledby="confirmModalLabel" 
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0">
            <div class="modal-header bg-danger border-0">
                <h1 class="modal-title text-white fs-5" 
                    id="confirmModalLabel">Confirmation</h1>
                <button type="button" 
                        class="btn-close btn-close-white" 
                        data-bs-dismiss="modal" 
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete record?</p>
            </div>
            <div class="modal-footer border-0">
                <button id="confirmBtn" 
                        class="normal-button">Confirm</button>
                <button type="button" 
                        class="normal-button" 
                        data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div>
    <div>
        <div class="page-header">
            <div class="row">
                <div class="col-12">
                    <h3 class="text-header">
                        Category And Role Mapping
                    </h3>
                </div>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-6 d-flex justify-content-start">
                <button class="normal-button" 
                        href="#add_role" 
                        data-bs-toggle="modal" 
                        data-target="#add_role">
                        <i class="fa fa-plus"></i> 
                        Create New
                </button>
            </div>
            <div class="col-sm-6 col-6">
                <div class="d-flex text-nowrap align-items-center gap-3 col-12">
                    <button id="removeSelected" 
                            data-bs-toggle="modal" 
                            data-bs-target="#confirmModal" 
                            class="normal-button bg-danger text-white" 
                            style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" 
                             width="16" 
                             height="16" 
                             fill="currentColor" 
                             class="bi bi-trash" 
                             viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                        </svg>
                        remove
                    </button>
                    <button id="cancelSelected" 
                            class="normal-button" 
                            style="display: none;">
                            cancel
                    </button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div id="myGrid" 
                     class="ag-theme-quartz" 
                     style="height: calc(100vh - 165px)">
                    @Html.AntiForgeryToken()
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Staff Role Modal -->
<div class="modal custom-modal fade rounded-0" 
     id="add_role" 
     aria-labelledby="add_role" 
     tabindex="-1" 
     role="dialog">
    <div class="modal-dialog modal-dialog-centered" 
         role="document">
        <div class="modal-content rounded-0">
            <div class="modal-header">
                <h5 class="modal-title">Add New category Role</h5>
                <button type="button" 
                        class="btn-close" 
                        data-bs-dismiss="modal" 
                        aria-labelledby="Close" 
                        tabindex="-1">
                </button>
            </div>
            <div class="modal-body">
                <form id="addCategoryRoleForm">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label class="col-form-label">Role</label>
                            <select id="roleSelect" 
                                    class="select custom-select">
                                @if (Model.Roles != null)
                                {
                                    @foreach (Domain.Entities.Role role in Model.Roles)
                                    {
                                        <option value="@role.Name">@role.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <label>Employee Category <span class="text-danger">*</span></label>
                        <input class="form-control" 
                               type="text" 
                               id="empCategory" required>
                    </div>
                    <div class="submit-section">
                        <button type="submit" 
                                class="btn lolc-bg submit-btn">
                            Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        function roleNameRenderer(params) {
            const role = roles.find(r => r.Name === params.value);
            return role ? role.Name : '';
        }
        function showToast(message, type = 'success', delay = 3000) {
            const toastContainer = document.getElementById('toast-message');
            toastContainer.className = `z-1000 position-fixed end-0 me-4 toast align-items-center text-white bg-${type} border-0`;
            toastContainer.setAttribute('role', 'alert');
            toastContainer.setAttribute('aria-live', 'assertive');
            toastContainer.setAttribute('aria-atomic', 'true');
            toastContainer.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            `;
            const toast = new bootstrap.Toast(toastContainer, { delay: delay });
            toast.show();

            // Remove toast content after it hides
            toastContainer.addEventListener('hidden.bs.toast', () => {
                toastContainer.innerHTML = '';
            });
        }

        function formatDate(dateStr) {
            if (!dateStr) return "";
            let date = new Date(dateStr);
            if (isNaN(date.getTime())) return "";

            return date.toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric"
            }) + " " + date.toLocaleTimeString("en-GB");
        }
    </script>
    <script>
        const roles = @Html.Raw(rolesJson) ?? [];
        const categoryRoles = @Html.Raw(categoryRolesJson) ?? [];

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const gridOptions = {
            pagination: true,
            paginationPageSize: 100,
            paginationPageSizeSelector: [20, 50, 100, 200],
            autoSizeStrategy: {
                type: "fitColumns",
                fit: true,
            },
            defaultColDef: {
                sortable: true,
                filter: true,
                resizable: true,
            },
            rowSelection: {mode: "multiRow"},
            rowData: categoryRoles,
            columnDefs: [
                { headerName: '#',
                    field: 'index',
                    valueGetter: params => params.node ? params.node.rowIndex + 1 : '',
                    sortable: false,
                    filter: false,
                    minWidth: 60
                },
                { headerName: "Role",
                    field: "RoleName",
                    editable: true,
                    cellRenderer: roleNameRenderer,
                    cellEditor: "agSelectCellEditor",
                    minWidth: 160,
                    cellEditorParams: {
                        values: roles.map(role => role.Name),
                        formatValue: roleName => roleName
                    },
                    valueGetter: params => params.data.RoleName,
                    valueSetter: params => {
                        const roleName = params.newValue;
                        const role = roles.find(r => r.Name === roleName);
                        if (role) {
                            params.data.RoleName = role.Name;
                            return true;
                        }
                        return false;
                    }
                },
                {
                    headerName: "Category",
                    field: "EmpCategory",
                    filter: "agTextColumnFilter",
                    editable: true,
                    minWidth: 160,
                },
                {
                    headerName: "Created Date",
                    field: "CreatedDate",
                    filter: "agTextColumnFilter",
                    sortable: true,
                    minWidth: 160,
                    valueFormatter: params => formatDate(params.value),
                },
                {
                    headerName: "Created By",
                    field: "CreatedBy",
                    filter: "agTextColumnFilter",
                    sortable: true,
                    minWidth: 100,
                },
                {
                    headerName: "Updated Date",
                    field: "UpdatedDate",
                    filter: "agTextColumnFilter",
                    sortable: true,
                    minWidth: 160,
                    valueFormatter: params => formatDate(params.value),
                },
                {
                    headerName: "Updated By",
                    field: "UpdatedBy",
                    filter: "agTextColumnFilter",
                    sortable: true,
                    minWidth: 100,
                },
            ],
            onGridReady: function(params) {
                params.api.sizeColumnsToFit();
            },
            onSelectionChanged: function() {
                const selectedRows = gridApi.getSelectedRows();
                const removeButton = document.getElementById('removeSelected');
                const cancelButton = document.getElementById('cancelSelected');
                if (selectedRows.length > 0) {
                    removeButton.style.display = 'block';
                    cancelButton.style.display = 'block';
                } else {
                    removeButton.style.display = 'none';
                    cancelButton.style.display = 'none';
                }
            },
            onCellEditingStopped: function(event) {
                if (event.value === event.oldValue) {
                    return;
                }

                if (event.colDef.field === 'RoleName' || event.colDef.field === 'EmpCategory') {
                    const updatedRoleName = event.data.RoleName;
                    const updatedEmpCategory = event.data.EmpCategory;
                    const updatedId = event.data.Id;

                    const updatedData = {
                        Id: updatedId,
                        RoleName: updatedRoleName,
                        EmpCategory: updatedEmpCategory
                    };

                    fetch('/Admin/UserManagement/CategoryRole?handler=UpdateCategoryRole', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'XSRF-TOKEN': token
                        },
                        body: JSON.stringify(updatedData)
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                showToast(data.message, 'success');
                            } else {
                                showToast(data.message, 'danger');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showToast('Error updating staff role', 'danger');
                        });
                }
            }
        };

        let gridApi;
        document.addEventListener("DOMContentLoaded", function () {
            const myGridElement = document.querySelector('#myGrid');
            gridApi = agGrid.createGrid(myGridElement, gridOptions);
        });

        let modal = new bootstrap.Modal('#add_role');
        document.getElementById('addCategoryRoleForm').addEventListener('submit', function(event) {
            event.preventDefault();

            const roleName = document.getElementById('roleSelect').value;
            const empCategory = document.getElementById('empCategory').value;

            const categoryRole = {
                RoleName: roleName,
                EmpCategory: empCategory
            };

            fetch('/Admin/UserManagement/CategoryRole?handler=CreateCategoryRole', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/json',
                    "XSRF-TOKEN":token
                },
                body: JSON.stringify(categoryRole)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        gridApi.applyTransaction({ add: [{
                                Id: data.data.id,
                                EmpCategory: data.data.empCategory,
                                RoleName: data.data.roleName,
                                Status:data.data.status,
                                CreatedDate: data.data.createdDate,
                                CreatedBy: data.data.createdBy,
                                UpdatedDate: data.data.updatedDate,
                                UpdatedBy: data.data.updatedBy,
                            }] });
                        showToast(data.message, 'success');
                        modal.hide();
                        document.getElementById('addCategoryRoleForm').reset();
                    } else {
                        showToast(data.message, 'danger');
                        modal.hide();
                        document.getElementById('addCategoryRoleForm').reset();
                    }
                })
                .catch(error => {
                    document.getElementById('addCategoryRoleForm').reset();
                    modal.hide();
                });
        });

        document.getElementById('cancelSelected').addEventListener('click', function() {
            gridApi.deselectAll();
        });

        document.getElementById('confirmBtn').addEventListener('click', function() {
            const selectedRows = gridApi.getSelectedRows();
            if (selectedRows.length > 0) {
                fetch('/Admin/UserManagement/CategoryRole?handler=DeleteCategoryRole', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        "XSRF-TOKEN": token
                    },
                    body: JSON.stringify(selectedRows)
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            $('#confirmModal').modal('hide');
                            gridApi.applyTransaction({ remove: selectedRows });
                            showToast(data.message, 'success');
                        } else {
                            $('#confirmModal').modal('hide');
                            showToast(data.message, 'danger');
                        }
                    })
                    .catch(error => {
                        $('#confirmModal').modal('hide');
                        showToast(error, 'danger');
                    });
            } else {
                $('#confirmModal').modal('hide');
                showToast('No rows selected', 'warning');
            }
        });

        const sidebar = document.querySelector(".sidebar");
        const observer = new MutationObserver(() => {
            if (gridApi) {
                setTimeout(() => {
                    gridApi.sizeColumnsToFit();
                }, 300);
            }
        });

        if (sidebar) {
            observer.observe(sidebar, { attributes: true, attributeFilter: ["class"] });
        }

    </script>
}

