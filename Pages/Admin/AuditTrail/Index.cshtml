@page
@model AssetManagement.Web.Pages.Admin.AuditTrail.IndexModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Audit Trail";
    var heading = new HeadingModel { Crumb = "Administration", Title = "Audit Trail", Subtitle = "Who did what, when and from where. Changes made through the web app and the API are recorded." };
    string[] methods = ["POST", "PUT", "PATCH", "DELETE", "GET"];
}

<partial name="_Heading" model="heading" />

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <p class="table-toolbar-title">Activity log</p>
            <p class="table-toolbar-sub">@Model.TotalItems entries</p>
        </div>
        <form method="get" class="table-toolbar-controls" style="display:flex; flex-wrap:wrap; align-items:center; gap:8px;">
            <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" class="toolbar-select" style="width:auto;" title="From" />
            <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" class="toolbar-select" style="width:auto;" title="To" />
            <select name="Module" class="toolbar-select" style="width:auto;">
                <option value="">All modules</option>
                @foreach (var m in Model.Modules)
                {
                    <option value="@m" selected="@(Model.Module == m)">@m</option>
                }
            </select>
            <select name="Method" class="toolbar-select" style="width:auto;">
                <option value="">All methods</option>
                @foreach (var m in methods)
                {
                    <option value="@m" selected="@(Model.Method == m)">@m</option>
                }
            </select>
            <input type="text" name="UserName" value="@Model.UserName" placeholder="User…" class="toolbar-select" style="width:130px;" />
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="URL or description…" class="toolbar-select" style="width:170px;" />
            <label style="font-size:12px; color:#475569; display:flex; align-items:center; gap:4px;">
                <input type="checkbox" name="FailedOnly" value="true" checked="@Model.FailedOnly" /> Failed only
            </label>
            <button type="submit" class="toolbar-btn">Filter</button>
            @if (Model.HasFilter)
            {
                <a asp-page="Index" class="toolbar-btn" style="color:#DC2626; border-color:#FCA5A5;">Clear</a>
            }
        </form>
    </div>

    <div style="overflow-x:auto;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>User</th>
                    <th>Module</th>
                    <th>Action</th>
                    <th>Method</th>
                    <th>Result</th>
                    <th>IP</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs.Count == 0)
                {
                    <tr><td colspan="8"><div class="empty-state"><p>No log entries found.</p></div></td></tr>
                }
                @foreach (var log in Model.Logs)
                {
                    var failed = log.ResponseStatus >= 400;
                    <tr>
                        <td><span class="cell-text">@log.CreatedOn.ToString("dd MMM yyyy HH:mm:ss")</span></td>
                        <td><div class="cell-name">@log.CreatedBy</div></td>
                        <td><span class="cell-text">@log.Module</span></td>
                        <td><span class="cell-mono">@log.Action</span></td>
                        <td><span class="cell-mono">@log.Method</span></td>
                        <td><span class="status-badge @(failed ? "maintenance" : "in-use")"><span class="dot"></span>@log.ResponseStatus @log.ResponseMessage</span></td>
                        <td><span class="cell-text">@log.IpAddress</span></td>
                        <td style="max-width:360px; white-space:normal;">
                            <details>
                                <summary class="cell-text">@(string.IsNullOrEmpty(log.Description) ? log.Url : log.Description)</summary>
                                <div class="cell-text" style="margin-top:6px; word-break:break-all;">
                                    <div><b>URL:</b> @log.Url@log.QueryParams</div>
                                    <div><b>Duration:</b> @log.Duration ms</div>
                                    @if (!string.IsNullOrEmpty(log.RequestBody))
                                    {
                                        <div><b>Body:</b></div>
                                        <pre style="margin:0; white-space:pre-wrap;">@log.RequestBody</pre>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="@((Model.PageNumber, Model.TotalPages, Model.TotalItems, "entries",
        (Func<int, string>)(p => Url.Page("Index", new { pageNumber = p, pageSize = Model.PageSize, From = Model.From?.ToString("yyyy-MM-dd"), To = Model.To?.ToString("yyyy-MM-dd"), Module = Model.Module, Method = Model.Method, UserName = Model.UserName, SearchTerm = Model.SearchTerm, FailedOnly = Model.FailedOnly ? "true" : null })!)))" />
</div>
