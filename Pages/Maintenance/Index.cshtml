@page
@model AssetManagement.Web.Pages.Maintenance.IndexModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Maintenance";
    ViewData["Tab"] = "due";
    var heading = new HeadingModel { Crumb = "Asset Operations", Title = "Maintenance Scheduler", Subtitle = "Planned maintenance that is overdue or coming up, and the work done on assets." };
    if (Model.CanComplete) heading.Actions.Add(new HeadingAction("Record Work", "/Maintenance/Records/Record"));
    if (Model.CanManage) heading.Actions.Add(new HeadingAction("New Schedule", "/Maintenance/Schedules/Create", null, true));
}

<partial name="_Heading" model="heading" />
<partial name="_Tabs" />
<partial name="_Messages" />

<div class="stat-cards-grid" style="grid-template-columns:repeat(3,1fr);">
    <div class="stat-card"><div class="stat-value red">@Model.OverdueCount</div><div class="stat-label">Overdue</div></div>
    <div class="stat-card"><div class="stat-value">@Model.DueSoonCount</div><div class="stat-label">Due soon</div></div>
    <div class="stat-card"><div class="stat-value">@Model.Due.Count</div><div class="stat-label">Shown</div></div>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <p class="table-toolbar-title">Due maintenance</p>
            <p class="table-toolbar-sub">@(Model.WithinDays is { } d ? $"Everything due within {d} days" : "Overdue and inside the reminder window")</p>
        </div>
        <form method="get" class="table-toolbar-controls" style="display:flex; align-items:center; gap:8px;">
            <input type="text" name="Department" value="@Model.Department" placeholder="Department" class="toolbar-select" style="width:140px;" />
            <input type="text" name="Location" value="@Model.Location" placeholder="Location" class="toolbar-select" style="width:140px;" />
            <select name="WithinDays" class="toolbar-select" style="width:auto;" onchange="this.form.submit()">
                <option value="">Overdue and due soon</option>
                <option value="30" selected="@(Model.WithinDays == 30)">Within 30 days</option>
                <option value="90" selected="@(Model.WithinDays == 90)">Within 90 days</option>
                <option value="365" selected="@(Model.WithinDays == 365)">Within a year</option>
            </select>
            <button type="submit" class="toolbar-btn">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Department) || !string.IsNullOrEmpty(Model.Location) || Model.WithinDays.HasValue)
            {
                <a asp-page="Index" class="toolbar-btn" style="color:#DC2626; border-color:#FCA5A5;">Clear</a>
            }
        </form>
    </div>

    <div style="overflow-x:auto;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Asset</th>
                    <th>Work</th>
                    <th>Location</th>
                    <th>Every</th>
                    <th>Next due</th>
                    <th>State</th>
                    <th>Last maintenance</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Due.Count == 0)
                {
                    <tr><td colspan="8"><div class="empty-state"><p>Nothing is due. Add schedules under the Schedules tab.</p></div></td></tr>
                }
                @foreach (var s in Model.Due)
                {
                    <tr>
                        <td><div class="cell-name">@s.AssetName</div><span class="cell-mono">@s.AssetNumber</span></td>
                        <td><span class="cell-text">@s.Title</span></td>
                        <td><span class="cell-text">@s.Location</span></td>
                        <td><span class="cell-text">@s.IntervalMonths mo</span></td>
                        <td><span class="cell-text">@s.NextDueDate.ToString("dd MMM yyyy")</span><div class="cell-text" style="font-size:11px;">@MaintenanceUi.DueText(s.DaysUntilDue)</div></td>
                        <td><span class="status-badge @MaintenanceUi.StateClass(s.DueState)"><span class="dot"></span>@MaintenanceUi.StateText(s.DueState)</span></td>
                        <td><span class="cell-text">@(s.LastMaintenanceDate?.ToString("dd MMM yyyy") ?? "-")</span></td>
                        <td class="text-right">
                            @if (Model.CanComplete)
                            {
                                <a asp-page="/Maintenance/Records/Record" asp-route-scheduleId="@s.Id" class="toolbar-btn">Record work</a>
                            }
                            @if (Model.CanManage)
                            {
                                <a asp-page="/Maintenance/Records/Create" asp-route-scheduleId="@s.Id" class="toolbar-btn">Plan</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
