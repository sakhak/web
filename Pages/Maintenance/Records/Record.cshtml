@page
@model AssetManagement.Web.Pages.Maintenance.Records.RecordModel
@using AssetManagement.Domain.Constants
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Record Maintenance";
    ViewData["Prefix"] = "Form";
    ViewData["Suppliers"] = Model.Suppliers;
    var heading = new HeadingModel { Crumb = "Maintenance", Title = "Record Maintenance", Subtitle = "Log work that has been done. For a schedule this moves the next due date forward." };
    heading.Actions.Add(new HeadingAction("Back to List", "/Maintenance/Records/Index"));
    var fromSchedule = Model.Form.ScheduleId.HasValue;
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<form method="post" novalidate>
    <input type="hidden" name="Form.ScheduleId" value="@Model.Form.ScheduleId" />
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe green"></div>
            <h4 class="form-card-title">Work done</h4>
        </div>
        <div class="form-card-body">
            <div style="display:grid; grid-template-columns:1fr 2fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label class="form-label-modern">Asset number <span style="color:#DC2626;">*</span></label>
                    <input name="Form.AssetNumber" value="@Model.Form.AssetNumber" class="form-input-modern" maxlength="150" @(fromSchedule ? "readonly" : "") required />
                </div>
                <div>
                    <label class="form-label-modern">Work @(fromSchedule ? "" : "*")</label>
                    <input name="Form.Title" value="@Model.Form.Title" class="form-input-modern" maxlength="200" />
                </div>
                <div>
                    <label class="form-label-modern">Type</label>
                    <select name="Form.Type" class="form-select-modern" disabled="@fromSchedule">
                        @foreach (var t in MaintenanceType.All)
                        {
                            <option value="@t" selected="@(Model.Form.Type == t)">@t</option>
                        }
                    </select>
                    @if (fromSchedule)
                    {
                        <input type="hidden" name="Form.Type" value="@MaintenanceType.Preventive" />
                    }
                </div>
            </div>
            <partial name="_WorkFields" model="(AssetManagement.Web.Models.CompleteWorkForm)Model.Form" view-data="ViewData" />
        </div>
    </div>
    <div class="form-actions">
        <a asp-page="Index" class="btn-modern btn-secondary-modern">Cancel</a>
        <button type="submit" class="btn-modern btn-primary-modern">Save</button>
    </div>
</form>
