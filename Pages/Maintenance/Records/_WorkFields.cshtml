@model AssetManagement.Web.Models.CompleteWorkForm
@{
    var prefix = ViewData["Prefix"]?.ToString() ?? "Form";
    var suppliers = ViewData["Suppliers"] as List<AssetManagement.Domain.Entities.Supplier> ?? [];
}
<div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:16px; margin-bottom:16px;">
    <div>
        <label class="form-label-modern">Work date <span style="color:#DC2626;">*</span></label>
        <input type="date" name="@(prefix).PerformedDate" value="@Model.PerformedDate?.ToString("yyyy-MM-dd")" class="form-input-modern" required />
    </div>
    <div>
        <label class="form-label-modern">Done by</label>
        <input name="@(prefix).PerformedBy" value="@Model.PerformedBy" class="form-input-modern" maxlength="200" placeholder="Technician or team" />
    </div>
    <div>
        <label class="form-label-modern">Cost</label>
        <input type="number" min="0" step="0.01" name="@(prefix).Cost" value="@Model.Cost" class="form-input-modern" />
    </div>
    <div>
        <label class="form-label-modern">Currency</label>
        <select name="@(prefix).Currency" class="form-select-modern">
            <option value="">Asset currency</option>
            <option value="USD" selected="@(Model.Currency == "USD")">USD</option>
            <option value="KHR" selected="@(Model.Currency == "KHR")">KHR</option>
        </select>
    </div>
</div>
<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
    <div>
        <label class="form-label-modern">Supplier</label>
        <select name="@(prefix).SupplierId" class="form-select-modern">
            <option value="">None</option>
            @foreach (var s in suppliers)
            {
                <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.FullName</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label-modern">Vendor name</label>
        <input name="@(prefix).VendorName" value="@Model.VendorName" class="form-input-modern" maxlength="250" placeholder="Used when no supplier is picked" />
    </div>
</div>
<div>
    <label class="form-label-modern">Notes</label>
    <textarea name="@(prefix).Notes" class="form-textarea-modern" rows="3" maxlength="2000">@Model.Notes</textarea>
</div>
