@page
@model AssetManagement.Web.Pages.Maintenance.Records.CreateModel
@using AssetManagement.Domain.Constants
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Plan Work Order";
    var heading = new HeadingModel { Crumb = "Maintenance", Title = "Plan Work Order", Subtitle = "Schedule maintenance on an asset. Start it when the work begins and complete it when it is done." };
    heading.Actions.Add(new HeadingAction("Back to List", "/Maintenance/Records/Index"));
    var fromSchedule = Model.Form.ScheduleId.HasValue;
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<form method="post" novalidate>
    <input type="hidden" name="Form.ScheduleId" value="@Model.Form.ScheduleId" />
    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-stripe blue"></div>
            <h4 class="form-card-title">Work order</h4>
        </div>
        <div class="form-card-body">
            <div style="display:grid; grid-template-columns:1fr 2fr 1fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label class="form-label-modern">Asset number <span style="color:#DC2626;">*</span></label>
                    <input name="Form.AssetNumber" value="@Model.Form.AssetNumber" class="form-input-modern" maxlength="150" @(fromSchedule ? "readonly" : "") required />
                </div>
                <div>
                    <label class="form-label-modern">Work @(fromSchedule ? "" : "*")</label>
                    <input name="Form.Title" value="@Model.Form.Title" class="form-input-modern" maxlength="200" />
                </div>
                <div>
                    <label class="form-label-modern">Type</label>
                    <select name="Form.Type" class="form-select-modern" disabled="@fromSchedule">
                        @foreach (var t in MaintenanceType.All)
                        {
                            <option value="@t" selected="@(Model.Form.Type == t)">@t</option>
                        }
                    </select>
                    @if (fromSchedule)
                    {
                        <input type="hidden" name="Form.Type" value="@MaintenanceType.Preventive" />
                    }
                </div>
                <div>
                    <label class="form-label-modern">Planned date</label>
                    <input type="date" name="Form.PlannedDate" value="@Model.Form.PlannedDate?.ToString("yyyy-MM-dd")" class="form-input-modern" />
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label class="form-label-modern">Supplier</label>
                    <select name="Form.SupplierId" class="form-select-modern">
                        <option value="">None</option>
                        @foreach (var s in Model.Suppliers)
                        {
                            <option value="@s.Id" selected="@(Model.Form.SupplierId == s.Id)">@s.FullName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label-modern">Vendor name</label>
                    <input name="Form.VendorName" value="@Model.Form.VendorName" class="form-input-modern" maxlength="250" placeholder="Used when no supplier is picked" />
                </div>
            </div>
            <div style="margin-bottom:16px;">
                <label class="form-label-modern">Notes</label>
                <textarea name="Form.Notes" class="form-textarea-modern" rows="3" maxlength="2000">@Model.Form.Notes</textarea>
            </div>
            <label style="font-size:13px; color:#334155; display:flex; align-items:center; gap:8px;">
                <input type="checkbox" name="Form.TakesAssetOutOfService" value="true" checked="@Model.Form.TakesAssetOutOfService" />
                The asset is out of service while the work is in progress (its status becomes Maintenance and is restored afterwards)
            </label>
        </div>
    </div>
    <div class="form-actions">
        <a asp-page="Index" class="btn-modern btn-secondary-modern">Cancel</a>
        <button type="submit" class="btn-modern btn-primary-modern">Plan Work Order</button>
    </div>
</form>
