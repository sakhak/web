@page
@model AssetManagement.Web.Pages.Reports.IndexModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Reports";
    var heading = new HeadingModel { Crumb = "Control", Title = "Reports", Subtitle = "Run a report on screen, print it to PDF, or export it to Excel." };
}

<partial name="_Heading" model="heading" />

@if (Model.Available.Count == 0)
{
    <div class="table-card"><div class="empty-state"><p>You do not have access to any report.</p></div></div>
}
else
{
    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px;">
        @foreach (var r in Model.Available)
        {
            <a asp-page="Run" asp-route-key="@r.Key" class="stat-card" style="text-decoration:none; display:block;">
                <div class="stat-value" style="font-size:17px; letter-spacing:-.3px; margin-bottom:8px;">@r.Title</div>
                <div class="cell-text" style="white-space:normal;">@r.Description</div>
            </a>
        }
    </div>
}
