@model AssetManagement.Application.Contracts.Reports.ReportDocument
@using AssetManagement.Web.Models

<div class="report-header">
    <h2 class="report-title">@Model.Title</h2>
    <div class="report-meta">
        Generated @Model.GeneratedAt.ToString("dd MMM yyyy HH:mm")@(string.IsNullOrEmpty(Model.GeneratedBy) ? "" : $" by {Model.GeneratedBy}")
    </div>
    @if (Model.Parameters.Count > 0)
    {
        <div class="report-meta">
            @foreach (var p in Model.Parameters)
            {
                <span style="margin-right:14px;"><b>@p.Key:</b> @p.Value</span>
            }
        </div>
    }
</div>

@foreach (var table in Model.Tables)
{
    <div class="report-table-block">
        @if (Model.Tables.Count > 1)
        {
            <h3 class="report-table-name">@table.Name</h3>
        }
        <table class="modern-table report-table">
            <thead>
                <tr>
                    @foreach (var c in table.Columns)
                    {
                        <th class="@(ReportFormat.IsNumeric(c.Kind) ? "text-right" : "")">@c.Header</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (table.Rows.Count == 0)
                {
                    <tr><td colspan="@table.Columns.Count"><div class="empty-state"><p>No data for the selected filters.</p></div></td></tr>
                }
                @foreach (var row in table.Rows)
                {
                    <tr>
                        @for (var i = 0; i < table.Columns.Count; i++)
                        {
                            <td class="@(ReportFormat.IsNumeric(table.Columns[i].Kind) ? "text-right" : "")">@ReportFormat.Cell(table.Columns[i].Kind, i < row.Length ? row[i] : null)</td>
                        }
                    </tr>
                }
            </tbody>
            @if (table.TotalRows.Count > 0)
            {
                <tfoot>
                    @foreach (var row in table.TotalRows)
                    {
                        <tr class="report-total">
                            @for (var i = 0; i < table.Columns.Count; i++)
                            {
                                <td class="@(ReportFormat.IsNumeric(table.Columns[i].Kind) ? "text-right" : "")">@ReportFormat.Cell(table.Columns[i].Kind, i < row.Length ? row[i] : null)</td>
                            }
                        </tr>
                    }
                </tfoot>
            }
        </table>
    </div>
}
