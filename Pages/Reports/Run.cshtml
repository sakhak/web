@page
@model AssetManagement.Web.Pages.Reports.RunModel
@using AssetManagement.Application.Contracts.Reports
@using AssetManagement.Web.Models
@{
    Layout = Model.Print ? "_ReportPrintLayout" : "Shared/_Layout";
    ViewData["Title"] = Model.Definition.Title;
    var d = Model.Definition;
    var heading = new HeadingModel { Crumb = "Reports", Title = d.Title, Subtitle = d.Description };
    heading.Actions.Add(new HeadingAction("All Reports", "/Reports/Index"));
    var query = new Dictionary<string, string?>
    {
        ["key"] = d.Key,
        ["From"] = Model.From?.ToString("yyyy-MM-dd"),
        ["To"] = Model.To?.ToString("yyyy-MM-dd"),
        ["AsOf"] = Model.AsOf?.ToString("yyyy-MM-dd"),
        ["Department"] = Model.Department,
        ["Location"] = Model.Location,
        ["Status"] = Model.Status,
        ["Type"] = Model.Type,
        ["ProfileId"] = Model.ProfileId?.ToString(),
        ["CategoryId"] = Model.CategoryId?.ToString()
    };
    var exportQuery = new Dictionary<string, string?>(query) { ["handler"] = "Export" };
    var printQuery = new Dictionary<string, string?>(query) { ["Print"] = "true" };
    bool Has(ReportFilterFields f) => d.Filters.HasFlag(f);
}

@if (Model.Print)
{
    <partial name="_ReportDocument" model="Model.Document" />
}
else
{
    <partial name="_Heading" model="heading" />

    <div class="table-card" style="margin-bottom:16px;">
        <form method="get" class="table-toolbar" style="gap:10px; align-items:flex-end;">
            <input type="hidden" name="key" value="@d.Key" />
            @if (Has(ReportFilterFields.DateRange))
            {
                <div><label class="form-label-modern">@d.DateRangeLabel from</label><input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-input-modern" /></div>
                <div><label class="form-label-modern">to</label><input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-input-modern" /></div>
            }
            @if (Has(ReportFilterFields.AsOf))
            {
                <div><label class="form-label-modern">As of</label><input type="date" name="AsOf" value="@Model.AsOf?.ToString("yyyy-MM-dd")" class="form-input-modern" /></div>
            }
            @if (Has(ReportFilterFields.Department))
            {
                <div><label class="form-label-modern">Department</label><input type="text" name="Department" value="@Model.Department" class="form-input-modern" /></div>
            }
            @if (Has(ReportFilterFields.Location))
            {
                <div><label class="form-label-modern">Location</label><input type="text" name="Location" value="@Model.Location" class="form-input-modern" /></div>
            }
            @if (Has(ReportFilterFields.Status))
            {
                <div><label class="form-label-modern">Status</label><input type="text" name="Status" value="@Model.Status" class="form-input-modern" placeholder="exact status" /></div>
            }
            @if (Has(ReportFilterFields.Type))
            {
                <div>
                    <label class="form-label-modern">Type</label>
                    <select name="Type" class="form-select-modern">
                        <option value="">All</option>
                        @foreach (var t in d.Key.StartsWith("maintenance") ? new[] { "Preventive", "Corrective" } : new[] { "Transfer", "Repair", "Disposal" })
                        {
                            <option value="@t" selected="@(Model.Type == t)">@t</option>
                        }
                    </select>
                </div>
            }
            @if (Has(ReportFilterFields.Category))
            {
                <div>
                    <label class="form-label-modern">Category</label>
                    <select name="CategoryId" class="form-select-modern">
                        <option value="">All</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Code - @c.Name</option>
                        }
                    </select>
                </div>
            }
            @if (Has(ReportFilterFields.Profile))
            {
                <div>
                    <label class="form-label-modern">Profile</label>
                    <select name="ProfileId" class="form-select-modern">
                        <option value="">All</option>
                        @foreach (var p in Model.Profiles)
                        {
                            <option value="@p.Id" selected="@(Model.ProfileId == p.Id)">@p.Code</option>
                        }
                    </select>
                </div>
            }
            <div style="display:flex; gap:8px;">
                <button type="submit" class="btn-modern btn-primary-modern">Run</button>
                <a asp-page="Run" asp-route-key="@d.Key" class="btn-modern btn-secondary-modern">Reset</a>
            </div>
            <div style="margin-left:auto; display:flex; gap:8px;">
                <a asp-page="Run" asp-all-route-data="@exportQuery" class="btn-modern btn-secondary-modern">Export Excel</a>
                <a asp-page="Run" asp-all-route-data="@printQuery" target="_blank" class="btn-modern btn-secondary-modern">Print / PDF</a>
            </div>
        </form>
    </div>

    <div class="table-card" style="padding:20px 22px; overflow-x:auto;">
        <partial name="_ReportDocument" model="Model.Document" />
    </div>
}
