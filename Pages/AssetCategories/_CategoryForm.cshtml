@model AssetManagement.Web.Models.AssetCategoryForm
@using AssetManagement.Application.Contracts.Onboarding
@{
    var isEdit = Model.Id > 0;
    var profiles = ViewData["Profiles"] as List<DepreciationProfileDto> ?? [];
}
<input type="hidden" name="Form.Id" value="@Model.Id" />
<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-stripe blue"></div>
        <h4 class="form-card-title">Category</h4>
    </div>
    <div class="form-card-body">
        <div style="display:grid; grid-template-columns:1fr 2fr; gap:16px; margin-bottom:16px;">
            <div>
                <label class="form-label-modern">Code <span style="color:#DC2626;">*</span></label>
                <input name="Form.Code" value="@Model.Code" class="form-input-modern" maxlength="30" @(isEdit ? "readonly" : "") placeholder="e.g. IT" required />
                @if (isEdit)
                {
                    <p class="form-hint">The code cannot be changed because purchase orders refer to it.</p>
                }
            </div>
            <div>
                <label class="form-label-modern">Name <span style="color:#DC2626;">*</span></label>
                <input name="Form.Name" value="@Model.Name" class="form-input-modern" maxlength="150" required />
            </div>
        </div>
        <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:16px;">
            <div>
                <label class="form-label-modern">Description</label>
                <textarea name="Form.Description" class="form-textarea-modern" rows="2" maxlength="500">@Model.Description</textarea>
            </div>
            <div>
                <label class="form-label-modern">Default depreciation profile</label>
                <select name="Form.DefaultProfileId" class="form-select-modern">
                    <option value="">Default (5 years)</option>
                    @foreach (var p in profiles)
                    {
                        <option value="@p.Id" selected="@(Model.DefaultProfileId == p.Id)">@p.Code (@p.UsefulLifeMonths m)</option>
                    }
                </select>
            </div>
            @if (isEdit)
            {
                <div>
                    <label class="form-label-modern">Status</label>
                    <select name="Form.Active" class="form-select-modern">
                        <option value="true" selected="@Model.Active">Active</option>
                        <option value="false" selected="@(!Model.Active)">Inactive</option>
                    </select>
                </div>
            }
        </div>
        <p class="form-hint">The default profile is used when assets of this category are tagged from a goods receipt and the purchase order line has no profile. It never changes assets that already have a profile.</p>
    </div>
</div>
