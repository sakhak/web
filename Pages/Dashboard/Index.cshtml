@page
@model AssetManagement.Web.Pages.Dashboard.IndexModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Dashboard";
    var d = Model.Data;
    var heading = new HeadingModel
    {
        Crumb = "Main",
        Title = "Dashboard",
        Subtitle = $"Asset overview as of {d.AsOf:dd MMM yyyy}. Depreciation figures cover assets still in service."
    };
    heading.Actions.Add(new HeadingAction("Reports", "/Reports/Index"));
    var servicePercent = d.TotalAssets > 0 ? Math.Round(d.InServiceAssets * 100.0 / d.TotalAssets) : 0;
    var alertCount = d.Alerts.Sum(a => a.Count);
    var maxStatus = Math.Max(1, d.ByStatus.Count == 0 ? 0 : d.ByStatus.Max(x => x.Count));
    var maxCategory = Math.Max(1, d.ByCategory.Count == 0 ? 0 : d.ByCategory.Max(x => x.Count));
    var maxDepartment = Math.Max(1, d.ByDepartment.Count == 0 ? 0 : d.ByDepartment.Max(x => x.Count));
    var statusTotal = d.ByStatus.Sum(x => x.Count);
    var categoryTotal = d.ByCategory.Sum(x => x.Count);
    var departmentTotal = d.ByDepartment.Sum(x => x.Count);
    string AlertClass(string? level) => level?.ToLowerInvariant() switch
    {
        "danger" => "is-danger",
        "warning" => "is-warning",
        _ => "is-info"
    };
    string StatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "completed" or "accepted" or "approved" or "active" => "badge-success",
        "pending" or "pending approval" or "dispatched" or "in progress" => "badge-warning",
        "rejected" or "cancelled" => "badge-danger",
        _ => "badge-neutral"
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<partial name="_Heading" model="heading" />
<div class="ux-dashboard">
    <section class="kpi-grid" aria-label="Asset summary">
        <div class="ux-card kpi-card">
            <div class="kpi-header"><span class="kpi-label">Total Assets</span><span class="kpi-icon icon-blue" aria-hidden="true">▣</span></div>
            <div class="kpi-value">@d.TotalAssets.ToString("N0")</div>
            <div class="kpi-meta"><span class="meta-pill">@d.InServiceAssets.ToString("N0") in service</span><span class="meta-muted">(@servicePercent%)</span></div>
        </div>
        <div class="ux-card kpi-card">
            <div class="kpi-header"><span class="kpi-label">Purchase Cost</span><span class="kpi-icon icon-slate" aria-hidden="true">$</span></div>
            <div class="kpi-multi-values">
                @if (d.Totals.Count == 0)
                {
                    <div class="kpi-value">0</div>
                }
                @foreach (var t in d.Totals)
                {
                    <div class="kpi-value-row"><span class="currency-code">@t.Currency</span><span class="kpi-figure">@t.Cost.ToString("N0")</span></div>
                }
            </div>
            <div class="kpi-meta"><span class="meta-muted">Original acquisition value</span></div>
        </div>
        <div class="ux-card kpi-card">
            <div class="kpi-header"><span class="kpi-label">Accumulated Depreciation</span><span class="kpi-icon icon-rose" aria-hidden="true">↘</span></div>
            <div class="kpi-multi-values">
                @if (d.Totals.Count == 0)
                {
                    <div class="kpi-value">0</div>
                }
                @foreach (var t in d.Totals)
                {
                    <div class="kpi-value-row"><span class="currency-code">@t.Currency</span><span class="kpi-figure text-danger">@t.Accumulated.ToString("N0")</span><span class="depreciation-tag">@t.DepreciatedPercent%</span></div>
                }
            </div>
            <div class="kpi-meta"><span class="meta-muted">Recognized life-to-date</span></div>
        </div>
        <div class="ux-card kpi-card">
            <div class="kpi-header"><span class="kpi-label">Net Book Value</span><span class="kpi-icon icon-emerald" aria-hidden="true">◇</span></div>
            <div class="kpi-multi-values">
                @if (d.Totals.Count == 0)
                {
                    <div class="kpi-value">0</div>
                }
                @foreach (var t in d.Totals)
                {
                    <div class="kpi-value-row"><span class="currency-code">@t.Currency</span><span class="kpi-figure text-emerald">@t.BookValue.ToString("N0")</span></div>
                }
            </div>
            <div class="kpi-meta"><span class="meta-muted">Current carrying value</span></div>
        </div>
    </section>
    <div class="bento-grid">
        <div class="bento-main">
            <section class="ux-card">
                <div class="card-header">
                    <div><h2 class="card-title">Needs Attention</h2><p class="card-subtitle">Open items across movements, disposals, lifecycle, and maintenance</p></div>
                    @if (alertCount > 0)
                    {
                        <span class="header-counter">@alertCount open</span>
                    }
                </div>
                <div class="card-body">
                    @if (d.Alerts.Count == 0)
                    {
                        <div class="ux-empty-state"><div class="empty-icon">✓</div><p class="empty-title">All caught up</p><p class="empty-desc">No pending actions require your attention right now.</p></div>
                    }
                    else
                    {
                        <div class="alert-list">
                            @foreach (var a in d.Alerts)
                            {
                                <a class="alert-item @AlertClass(a.Level)" href="@a.Link"><span class="alert-badge">@a.Count</span><span class="alert-content"><span class="alert-title">@a.Title</span><span class="alert-detail">@a.Detail</span></span><span class="alert-chevron" aria-hidden="true">›</span></a>
                            }
                        </div>
                    }
                </div>
            </section>
            <section class="ux-card">
                <div class="card-header">
                    <div><h2 class="card-title">Recent Movements</h2><p class="card-subtitle">Latest asset transfers, assignments, and custody updates</p></div>
                    <div class="movement-actions">
                        <div class="filter-pills" role="group" aria-label="Filter movements by status">
                            <button type="button" class="filter-pill active" data-movement-filter="all" aria-pressed="true">All</button>
                            <button type="button" class="filter-pill" data-movement-filter="pending" aria-pressed="false">Pending</button>
                            <button type="button" class="filter-pill" data-movement-filter="pending approval" aria-pressed="false">Pending Approval</button>
                            <button type="button" class="filter-pill" data-movement-filter="dispatched" aria-pressed="false">Dispatched</button>
                            <button type="button" class="filter-pill" data-movement-filter="accepted" aria-pressed="false">Accepted</button>
                            <button type="button" class="filter-pill" data-movement-filter="completed" aria-pressed="false">Completed</button>
                        </div>
                        <a asp-page="/AssetMovements/Index" class="btn-ghost">View all →</a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="ux-table">
                        <thead><tr><th>Asset</th><th>Type</th><th>Route (From → To)</th><th>Status</th><th class="text-right">Requested</th></tr></thead>
                        <tbody id="movementsTableBody">
                            @foreach (var m in d.RecentMovements)
                            {
                                <tr data-movement-status="@m.Status">
                                    <td><div class="asset-cell"><span class="asset-name">@m.AssetName</span><span class="asset-code">@m.AssetNumber</span></div></td>
                                    <td><span class="type-tag">@m.MovementType</span></td>
                                    <td><div class="route-cell"><span class="route-node" title="@m.From">@m.From</span><span class="route-arrow">→</span><span class="route-node route-dest" title="@m.To">@m.To</span></div></td>
                                    <td><span class="status-badge @StatusClass(m.Status)"><span class="status-dot"></span>@m.Status</span></td>
                                    <td class="text-right"><span class="date-cell">@m.RequestDate?.ToString("dd MMM yyyy")</span></td>
                                </tr>
                            }
                            <tr id="movementsEmptyRow" hidden><td colspan="5"><div class="ux-empty-state"><p class="empty-title">No movements recorded</p><p class="empty-desc">No movements match the selected status.</p></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <aside class="bento-sidebar">
            <section class="ux-card">
                <div class="card-header"><h2 class="card-title">Assets by Status</h2></div><div class="card-body">
                @if (d.ByStatus.Count == 0)
                {
                    <p class="empty-inline">No assets registered yet.</p>
                }
                else
                {

                    <div class="metric-bars">@foreach (var s in d.ByStatus) {
                        <div class="metric-row"><div class="metric-info"><span class="metric-label">@s.Label</span><span class="metric-count-group"><span class="metric-count">@s.Count.ToString("N0")</span><span class="metric-pct">(@(statusTotal > 0 ? Math.Round(s.Count * 100.0 / statusTotal) : 0)%)</span></span></div><div class="progress-track"><div class="progress-fill fill-blue" style="width:@(s.Count * 100.0 / maxStatus)%"></div></div></div>
                    }
                </div>
            }
        </div>
    </section>
    <section class="ux-card">
        <div class="card-header"><h2 class="card-title">Assets by Category</h2></div><div class="card-body">
        @if (d.ByCategory.Count == 0)
        {
            <p class="empty-inline">No categories available.</p>
        }
        else
        {

            <div class="metric-bars">@foreach (var s in d.ByCategory) {
                <div class="metric-row"><div class="metric-info"><span class="metric-label">@s.Label</span><span class="metric-count-group"><span class="metric-count">@s.Count.ToString("N0")</span><span class="metric-pct">(@(categoryTotal > 0 ? Math.Round(s.Count * 100.0 / categoryTotal) : 0)%)</span></span></div><div class="progress-track"><div class="progress-fill fill-violet" style="width:@(s.Count * 100.0 / maxCategory)%"></div></div></div>
            }
        </div>
    }
</div>
</section>
<section class="ux-card">
    <div class="card-header"><h2 class="card-title">Top Departments</h2></div><div class="card-body">
    @if (d.ByDepartment.Count == 0)
    {
        <p class="empty-inline">No department data yet.</p>
    }
    else
    {

        <div class="metric-bars">@foreach (var s in d.ByDepartment) {
            <div class="metric-row"><div class="metric-info"><span class="metric-label">@s.Label</span><span class="metric-count-group"><span class="metric-count">@s.Count.ToString("N0")</span><span class="metric-pct">(@(departmentTotal > 0 ? Math.Round(s.Count * 100.0 / departmentTotal) : 0)%)</span></span></div><div class="progress-track"><div class="progress-fill fill-emerald" style="width:@(s.Count * 100.0 / maxDepartment)%"></div></div></div>
        }
    </div>
}
</div>
</section>
</aside>
</div>
</div>
<script>
    (() => {
        const rows = Array.from(document.querySelectorAll('#movementsTableBody tr[data-movement-status]'));
        const emptyRow = document.getElementById('movementsEmptyRow');
        const buttons = document.querySelectorAll('[data-movement-filter]');
        function filter(status) {
            let visible = 0;
            rows.forEach(row => {
                const match = status === 'all' || row.dataset.movementStatus?.trim().toLowerCase() === status;
                row.hidden = !match;
                if (match) visible++;
            });
            emptyRow.hidden = visible > 0;
            buttons.forEach(button => {
                const active = button.dataset.movementFilter === status;
                button.classList.toggle('active', active);
                button.setAttribute('aria-pressed', String(active));
            });
        }
        buttons.forEach(button => button.addEventListener('click', () => filter(button.dataset.movementFilter)));
        filter('all');
    })();
</script>
