@page
@model AssetManagement.Web.Pages.Supplier.IndexModel
@using AssetManagement.Domain.Enums
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Supplier Management";
    var heading = new HeadingModel { Crumb = "Procurement", Title = "Supplier Management", Subtitle = "Vendors that assets are purchased from." };
    if (Model.CanManage) heading.Actions.Add(new HeadingAction("New Supplier", "/Supplier/Create", null, true));
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<div class="stat-cards-grid" style="grid-template-columns:repeat(3,1fr);">
    <div class="stat-card"><div class="stat-value">@Model.Counts.Total</div><div class="stat-label">Total suppliers</div></div>
    <div class="stat-card"><div class="stat-value">@Model.Counts.Active</div><div class="stat-label">Active</div></div>
    <div class="stat-card"><div class="stat-value">@Model.Counts.Inactive</div><div class="stat-label">Inactive</div></div>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <p class="table-toolbar-title">Suppliers</p>
            <p class="table-toolbar-sub">@Model.TotalItems found</p>
        </div>
        <div class="table-toolbar-controls">
            <form method="get" style="display:flex; align-items:center; gap:8px;">
                <select name="Status" class="toolbar-select" style="width:auto;" onchange="this.form.submit()">
                    <option value="">All statuses</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
                <div class="toolbar-search">
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Name, contact, phone, email…" style="width:230px;" />
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.Status))
                {
                    <a asp-page="Index" class="toolbar-btn" style="color:#DC2626; border-color:#FCA5A5;">Clear</a>
                }
            </form>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Status</th>
                    @if (Model.CanManage)
                    {
                        <th class="text-right">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Suppliers.Count == 0)
                {
                    <tr><td colspan="7"><div class="empty-state"><p>No suppliers found.</p></div></td></tr>
                }
                @foreach (var s in Model.Suppliers)
                {
                    var active = s.Status == BaseStatus.Active;
                    <tr>
                        <td><div class="cell-name">@s.FullName</div></td>
                        <td><span class="cell-text">@s.ContactPerson</span></td>
                        <td><span class="cell-text">@s.PhoneNumber</span></td>
                        <td><span class="cell-text">@s.Email</span></td>
                        <td><span class="cell-text">@s.AddressLine1</span></td>
                        <td><span class="status-badge @(active ? "active" : "inactive")"><span class="dot"></span>@s.Status</span></td>
                        @if (Model.CanManage)
                        {
                            <td class="text-right">
                                <a asp-page="Edit" asp-route-id="@s.Id" class="toolbar-btn">Edit</a>
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@s.Id" asp-route-active="@(!active)" style="display:inline;">
                                    <button type="submit" class="toolbar-btn">@(active ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="@((Model.PageNumber, Model.TotalPages, Model.TotalItems, "suppliers",
        (Func<int, string>)(p => Url.Page("Index", new { pageNumber = p, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, status = Model.Status })!)))" />
</div>
