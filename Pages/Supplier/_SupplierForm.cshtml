@model AssetManagement.Web.Models.SupplierForm
@{
    var isEdit = Model.Id != Guid.Empty;
}
<input type="hidden" name="Form.Id" value="@Model.Id" />
<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-stripe blue"></div>
        <h4 class="form-card-title">Supplier Details</h4>
    </div>
    <div class="form-card-body">
        <div style="display:grid; grid-template-columns:2fr 1fr; gap:16px; margin-bottom:16px;">
            <div>
                <label class="form-label-modern">Full name <span style="color:#DC2626;">*</span></label>
                <input name="Form.FullName" value="@Model.FullName" class="form-input-modern" maxlength="250" required />
            </div>
            <div>
                <label class="form-label-modern">Contact person</label>
                <input name="Form.ContactPerson" value="@Model.ContactPerson" class="form-input-modern" maxlength="250" />
            </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div>
                <label class="form-label-modern">Phone number <span style="color:#DC2626;">*</span></label>
                <input name="Form.PhoneNumber" value="@Model.PhoneNumber" class="form-input-modern" maxlength="30" required />
            </div>
            <div>
                <label class="form-label-modern">Email</label>
                <input type="email" name="Form.Email" value="@Model.Email" class="form-input-modern" maxlength="250" />
            </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div>
                <label class="form-label-modern">Address line 1 <span style="color:#DC2626;">*</span></label>
                <input name="Form.AddressLine1" value="@Model.AddressLine1" class="form-input-modern" maxlength="500" required />
            </div>
            <div>
                <label class="form-label-modern">Address line 2</label>
                <input name="Form.AddressLine2" value="@Model.AddressLine2" class="form-input-modern" maxlength="500" />
            </div>
        </div>
        <div style="display:grid; grid-template-columns:3fr 1fr; gap:16px;">
            <div>
                <label class="form-label-modern">Notes</label>
                <textarea name="Form.Description" class="form-textarea-modern" rows="2" maxlength="500">@Model.Description</textarea>
            </div>
            @if (isEdit)
            {
                <div>
                    <label class="form-label-modern">Status</label>
                    <select name="Form.Active" class="form-select-modern">
                        <option value="true" selected="@Model.Active">Active</option>
                        <option value="false" selected="@(!Model.Active)">Inactive</option>
                    </select>
                </div>
            }
        </div>
    </div>
</div>
