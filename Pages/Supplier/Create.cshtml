@page
@model AssetManagement.Web.Pages.Supplier.CreateModel
@using AssetManagement.Web.Models
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "New Supplier";
    var heading = new HeadingModel { Crumb = "Procurement", Title = "New Supplier" };
    heading.Actions.Add(new HeadingAction("Back to List", "/Supplier/Index"));
}

<partial name="_Heading" model="heading" />
<partial name="_Messages" />

<form method="post" novalidate>
    <partial name="_SupplierForm" model="Model.Form" />
    <div class="form-actions">
        <a asp-page="Index" class="btn-modern btn-secondary-modern">Cancel</a>
        <button type="submit" class="btn-modern btn-primary-modern">Create Supplier</button>
    </div>
</form>
