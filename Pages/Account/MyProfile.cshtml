@page
@using System.Security.Claims
@model AssetManagement.Web.Pages.Account.MyProfile
@{
    Layout = "Shared/_Layout";
    string profileImageUrl = Url.Content("~/lib/assets/img/user.jpg");
    var role = User.Claims.FirstOrDefault(x => x.Type == ClaimTypes.Role)?.Value;
    var proxyRole = User.Claims.FirstOrDefault(c => c.Type == "Proxy")?.Value;
}

<div class="custom-page-wrapper m-5">
    <div class="content container-fluid">

        <!-- Page Header -->
        <div class="page-header">
            <div class="row">
                <div class="col-sm-12">
                    <h3 class="page-title">Profile</h3>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                        <li class="breadcrumb-item active">Profile</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- /Page Header -->

        <div class="card mb-0">
            <div class="card-body p-5">
                <div class="row">
                    <div class="col-md-12">
                        <div class="profile-view">
                            <div class="profile-img-wrap">
                                <div class="profile-img">
                                    <a href="#"><img alt="" src="@profileImageUrl"></a>
                                </div>
                            </div>
                            <div class="profile-basic">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="profile-info-left">
                                            <h3 class="user-name m-t-0 mb-0">@(Model.UserInfo?.LastName + ' ' + Model.UserInfo?.FirstName)</h3>
                                            <h6 class="text-muted">@Model.UserInfo?.KhmerName</h6>
                                            <small class="text-muted">@Model.UserInfo?.PostTitle</small>
                                            <div class="staff-id">Employee ID : @Model.UserInfo?.StaffId</div>
                                            <div class="small doj text-muted">Date of Join : @Model.UserInfo?.DateJoin</div>
                                            <div class="staff-msg ">
                                                <div class="btn lolc-bg">
                                                    Role:
                                                    @proxyRole
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <ul class="personal-info">
                                            <li>
                                                <div class="title">Phone:</div>
                                                <div class="text"><a href="">@Model.UserInfo?.Mobile</a></div>
                                            </li>
                                            <li>
                                                <div class="title">Email:</div>
                                                <div class="text"><a href="">@Model.UserInfo?.Mail</a></div>
                                            </li>
                                            <li>
                                                <div class="title">Material Status:</div>
                                                <div class="text">@Model.UserInfo?.MaterialStatus</div>
                                            </li>
                                            <li>
                                                <div class="title">Department:</div>
                                                <div class="text">@Model.UserInfo?.Department</div>
                                            </li>
                                            <li>
                                                <div class="title">Gender:</div>
                                                <div class="text">@Model.UserInfo?.Gender</div>
                                            </li>
                                            <li>
                                                <div class="title">Branch:</div>
                                                <div class="text">
                                                    @Model.UserInfo?.BranchName
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>