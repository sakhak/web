@* Parameters: Title, Value, ColorClass (blue|green|amber|red), BadgeText, IconPath *@
@{
    string title     = ViewData["StatTitle"]?.ToString() ?? "";
    string value     = ViewData["StatValue"]?.ToString() ?? "0";
    string color     = ViewData["StatColor"]?.ToString() ?? "blue";
    string badge     = ViewData["StatBadge"]?.ToString() ?? "";
    string iconPath  = ViewData["StatIcon"]?.ToString() ?? "";
}
<div class="stat-card">
    <div class="stat-card-top">
        <div class="stat-icon @color">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @Html.Raw(iconPath)
            </svg>
        </div>
        @if (!string.IsNullOrEmpty(badge))
        {
            <span class="stat-badge @color">@badge</span>
        }
    </div>
    <div class="stat-value @(color == "red" ? "red" : "")">@value</div>
    <div class="stat-label">@title</div>
</div>
