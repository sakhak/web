@* Parameters: Title, Subtitle, Breadcrumb, actions rendered via ViewData["PageHeaderActions"] *@
@{
    string title     = ViewData["PageTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "";
    string subtitle  = ViewData["PageSubtitle"]?.ToString() ?? "";
    string crumbPre  = ViewData["Page-PreTitle"]?.ToString() ?? "Overview";
}
<div class="page-heading">
    <div class="breadcrumb-row">
        <span class="crumb muted">@crumbPre</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
        </svg>
        <span class="crumb active">@title</span>
    </div>
    <div class="page-heading-row">
        <div>
            <h1 class="page-title">@title</h1>
            @if (!string.IsNullOrEmpty(subtitle))
            {
                <p class="page-subtitle">@subtitle</p>
            }
        </div>
        <div class="page-actions">
            @RenderSection("PageActions", required: false)
        </div>
    </div>
</div>
