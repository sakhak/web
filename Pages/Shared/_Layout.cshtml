@using System.Security.Claims
@using AssetManagement.Web.Extensions
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@{
    var useLocalLogin = AuthenticationExtensions.IsLocalLoginEnabled(Configuration, HostEnvironment);
    var first = User.Claims.FirstOrDefault(c => c.Type == "DisplayName");
    string username = first?.Value ?? "User";
    var proxyRole = User.Claims.FirstOrDefault(c => c.Type == "Proxy")?.Value;
    string role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
    string dept = User.Claims.FirstOrDefault(c => c.Type == "Department")?.Value ?? "";
    string branch = User.Claims.FirstOrDefault(c => c.Type == "Branch")?.Value ?? "";
    bool isAssetMenuOpen = Context.Request.Path.StartsWithSegments("/Assets") || Context.Request.Path.StartsWithSegments("/AssetMovements") || Context.Request.Path.StartsWithSegments("/AssetCategories") || Context.Request.Path.StartsWithSegments("/Onboarding");

    // Avatar initials
    var parts = username.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
    string initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}"
        : username.Length >= 2 ? username[..2].ToUpper() : username.ToUpper();

    if (!User.Identity?.IsAuthenticated ?? true)
    {
        var signInPath = useLocalLogin ? "/Login" : "/MicrosoftIdentity/Account/SignIn";
        <script>window.location.href = '@signInPath';</script>
    }
}
@functions {
    bool IsActive(string route) => Context.Request.Path.Equals(route);
    bool IsActiveExact(string route) => Context.Request.Path.Equals(route);
    bool HasAnyRole(params string[] roles) => roles.Any(r => User.IsInRole(r));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Assets System</title>
    <link rel="shortcut icon" href="~/img/lolc.png" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />
    <link href="~/lib/tabler/dist/libs/litepicker/dist/litepicker.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="app-shell">

    <!-- ━━━  SIDEBAR  ━━━ -->
    <aside class="app-sidebar" id="app-sidebar">

        <!-- Logo -->
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <span>LOLC</span>
            </div>
            <div class="sidebar-brand-text">
                <div class="name">Assets System</div>
                <div class="sub">Enterprise Platform</div>
            </div>
            <button class="sidebar-toggle" id="sidebar-toggle" type="button"
                    title="Show navigation" aria-label="Show navigation"
                    aria-controls="app-sidebar" aria-expanded="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M9 3v18" />
                    <path d="m15 9-3 3 3 3" />
                </svg>
            </button>
        </div>

        <!-- Nav -->
        <nav class="sidebar-nav">

            <div class="nav-section-label">Main</div>

            <a asp-page="/Dashboard/Index" title="Dashboard" class="nav-item-link @(IsActive("/Dashboard/Index") || IsActive("/Dashboard") || IsActiveExact("/") ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
                Dashboard
            </a>

            <div class="nav-section-label">Asset Operations</div>

            <!-- Assets group toggle -->
            <div class="nav-item-link nav-group-toggle @(isAssetMenuOpen ? "open active" : "")" id="assets-toggle" title="Assets Management">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
                    <rect x="9" y="3" width="6" height="4" rx="1"/>
                    <line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>
                </svg>
                Assets Management
                <svg class="chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </div>
            <div class="nav-group-items @(isAssetMenuOpen ? "open" : "")" id="assets-group">
                <a asp-page="/Assets/Index" class="nav-item-link @(IsActive("/Assets") ? "active" : "")">
                    List of Assets
                </a>
                <a asp-page="/AssetMovements/Index" class="nav-item-link @(IsActive("/AssetMovements") ? "active" : "")">
                    Asset Movements
                </a>
                <a asp-page="/Onboarding/PurchaseOrders/Index" class="nav-item-link @(Context.Request.Path.StartsWithSegments("/Onboarding") ? "active" : "")">Asset Onboarding</a>
                <a asp-page="/AssetMovements/Disposal/Index" class="nav-item-link @(IsActive("/AssetMovements/Disposal") ? "active" : "")">
                    Asset Disposal
                </a>
                <a asp-page="#" class="nav-item-link">Asset Lifecycle</a>
                <a asp-page="/AssetCategories/Index" class="nav-item-link @(IsActive("/AssetCategories") ? "active" : "")">
                    Asset Categories
                </a>
            </div>

            <div class="nav-section-label">Procurement</div>

            <a asp-page="/Supplier/Index" title="Supplier Management" class="nav-item-link @(IsActive("/Supplier") ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13" rx="1"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
                Supplier Management
            </a>

            <a asp-page="/Maintenance/Index" title="Maintenance Scheduler" class="nav-item-link @(Context.Request.Path.StartsWithSegments("/Maintenance") ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Maintenance Scheduler
            </a>

            <div class="nav-section-label">Control</div>

            <a href="#" title="Inventory and Auditing" class="nav-item-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
                Inventory &amp; Auditing
            </a>

            <a asp-page="/Reports/Index" title="Reports" class="nav-item-link @(Context.Request.Path.StartsWithSegments("/Reports") ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/>
                    <line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                Reports
            </a>

            @if (HasAnyRole("ADMIN"))
            {
                <div class="nav-section-label">Administration</div>

                <div class="nav-item-link nav-group-toggle @(IsActive("/Admin") ? "open active" : "")" id="admin-toggle" title="Admin Management">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"/><path d="M6 20v-1a6 6 0 0 1 12 0v1"/>
                    </svg>
                    Admin Management
                    <svg class="chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
                <div class="nav-group-items @(IsActive("/Admin") ? "open" : "")" id="admin-group">
                    <a class="nav-item-link @(IsActive("/Admin/UserManagement/Index") ? "active" : "")" href="/Admin/UserManagement/Index">User Info</a>
                    @if (HasAnyRole("ADMIN"))
                    {
                        <a class="nav-item-link @(IsActive("/Admin/UserManagement/Role") ? "active" : "")" href="/Admin/UserManagement/Role/Index">Role</a>
                    }
                    <a class="nav-item-link @(IsActive("/Admin/UserManagement/UserRole") ? "active" : "")" href="/Admin/UserManagement/UserRole/Index">User Role</a>
                    <a class="nav-item-link @(IsActive("/Admin/AuditTrail/Index") ? "active" : "")" href="/Admin/AuditTrail/Index">Audit Trail</a>
                    @if (HasAnyRole("ADMIN"))
                    {
                        <a class="nav-item-link @(IsActive("/Admin/UserManagement/StaffRole") ? "active" : "")" href="/Admin/UserManagement/StaffRole/Index">Position Role</a>
                        <a class="nav-item-link @(IsActive("/Admin/UserManagement/CategoryRole") ? "active" : "")" href="/Admin/UserManagement/CategoryRole/Index">Category Role</a>
                    }
                </div>
            }

        </nav>

        <!-- User footer -->
        <div class="sidebar-user user-dropdown-wrapper" id="sidebar-user-btn">
            <div class="sidebar-avatar">@initials</div>
            <div style="flex:1; min-width:0;">
                <div class="sidebar-user-name">@username</div>
                <div class="sidebar-user-role">@(string.IsNullOrEmpty(dept) ? role : $"{role} · {dept}")</div>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
            </svg>
        </div>

    </aside>

    <!-- ━━━  MAIN  ━━━ -->
    <div class="app-main">

        <!-- Header -->
        <header class="app-header">
            <!-- Search -->
            <div class="header-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" id="global-search-input" placeholder="Search assets, departments…" autocomplete="off" />
            </div>

            <div class="header-spacer"></div>

            <!-- Notifications -->
            <button class="header-icon-btn" title="Notifications">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <span class="notif-dot"></span>
            </button>

            <div class="header-divider"></div>

            <!-- User menu -->
            <div class="user-dropdown-wrapper">
                <div class="header-user" id="header-user-btn">
                    <div class="header-avatar">@initials</div>
                    <div>
                        <div class="header-user-name">@username</div>
                        <div class="header-user-role">@role@(string.IsNullOrEmpty(branch) ? "" : $" · {branch}")</div>
                    </div>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </div>

                <div class="user-dropdown-menu" id="header-user-menu">
                    <a href="/account/myprofile" class="user-dropdown-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                        My Profile
                    </a>
                    <div class="dropdown-sep"></div>
                    @if (useLocalLogin)
                    {
                        <form method="post" asp-page="/Login" asp-page-handler="SignOut">
                            <button type="submit" class="user-dropdown-item danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                                Sign Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="user-dropdown-item danger"
                           href="/MicrosoftIdentity/Account/SignOut">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Sign Out
                        </a>
                    }
                </div>
            </div>
        </header>

        <!-- Page body -->
        <div class="app-body">
            @RenderBody()
        </div>

    </div><!-- /app-main -->

</div><!-- /app-shell -->

<!-- ───── Scripts ───── -->
<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/lib/tabler/dist/libs/litepicker/dist/litepicker.js" asp-append-version="true"></script>

<script>
(function () {
    // Nav group toggles
    function initNavGroup(toggleId, groupId) {
        const toggle = document.getElementById(toggleId);
        const group  = document.getElementById(groupId);
        if (!toggle || !group) return;
        toggle.addEventListener('click', function () {
            const shell = document.querySelector('.app-shell');
            const sidebarElement = document.getElementById('app-sidebar');
            const toggleButton = document.getElementById('sidebar-toggle');
            const isMobile = window.matchMedia('(max-width: 768px)').matches;
            const isCollapsed = isMobile
                ? !sidebarElement?.classList.contains('open')
                : shell?.classList.contains('sidebar-collapsed');

            if (isCollapsed) {
                if (isMobile) {
                    sidebarElement?.classList.add('open');
                } else {
                    shell?.classList.remove('sidebar-collapsed');
                }
                toggleButton?.setAttribute('aria-expanded', 'true');
                toggleButton?.setAttribute('aria-label', 'Collapse navigation');
                if (toggleButton) toggleButton.title = 'Collapse navigation';
            }

            const open = group.classList.toggle('open');
            toggle.classList.toggle('open', open);
            toggle.classList.toggle('active', open || toggle.classList.contains('active'));
        });
    }
    initNavGroup('assets-toggle', 'assets-group');
    initNavGroup('admin-toggle',  'admin-group');

    // User dropdown (header)
    const headerBtn  = document.getElementById('header-user-btn');
    const headerMenu = document.getElementById('header-user-menu');
    if (headerBtn && headerMenu) {
        headerBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            headerMenu.classList.toggle('show');
        });
        document.addEventListener('click', function () {
            headerMenu.classList.remove('show');
        });
    }

    // Sidebar toggle
    const sidebarToggle = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('app-sidebar');
    const appShell = document.querySelector('.app-shell');
    if (sidebarToggle && sidebar && appShell) {
        const mobileSidebar = window.matchMedia('(max-width: 768px)');
        function updateSidebarToggle() {
            const expanded = mobileSidebar.matches
                ? sidebar.classList.contains('open')
                : !appShell.classList.contains('sidebar-collapsed');
            sidebarToggle.setAttribute('aria-expanded', expanded);
            sidebarToggle.setAttribute('aria-label', expanded ? 'Collapse navigation' : 'Show navigation');
            sidebarToggle.title = expanded ? 'Collapse navigation' : 'Show navigation';
        }

        sidebarToggle.addEventListener('click', function () {
            if (mobileSidebar.matches) {
                sidebar.classList.toggle('open');
            } else {
                appShell.classList.toggle('sidebar-collapsed');
            }
            updateSidebarToggle();
        });
        mobileSidebar.addEventListener('change', updateSidebarToggle);
        updateSidebarToggle();
    }

    // Action dropdowns (delegated)
    document.addEventListener('click', function (e) {
        const trigger = e.target.closest('[data-action-toggle]');
        if (trigger) {
            e.stopPropagation();
            const menuId = trigger.getAttribute('data-action-toggle');
            const menu = document.getElementById(menuId);
            if (!menu) return;
            // close others
            document.querySelectorAll('.action-dropdown-menu.show').forEach(function (m) {
                if (m !== menu) m.classList.remove('show');
            });
            menu.classList.toggle('show');
            return;
        }
        // Close all action menus when clicking outside
        document.querySelectorAll('.action-dropdown-menu.show').forEach(function (m) {
            m.classList.remove('show');
        });
    });

    // Global search (Ctrl+K focus)
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            const inp = document.getElementById('global-search-input');
            if (inp) inp.focus();
        }
    });
})();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
