@model (int PageNumber, int TotalPages, int TotalItems, string Noun, Func<int, string> Url)
<div class="table-footer">
    <span class="table-footer-info">@Model.TotalItems @Model.Noun</span>
    <div class="pagination-modern">
        <a class="page-btn @(Model.PageNumber <= 1 ? "disabled" : "")" href="@Model.Url(Model.PageNumber - 1)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        @for (var i = 1; i <= Math.Max(Model.TotalPages, 1); i++)
        {
            <a class="page-btn @(i == Model.PageNumber ? "active" : "")" href="@Model.Url(i)">@i</a>
        }
        <a class="page-btn @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")" href="@Model.Url(Model.PageNumber + 1)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
    </div>
</div>
