    SELECT "p"."ID", "p"."APPROVED_AT", "p"."APPROVED_BY", "p"."CREATED_AT", "p"."CREATED_BY", "p"."CURRENCY", "p"."ORDER_DATE", "p"."PO_NUMBER", "p"."REMARKS", "p"."STATUS", "p"."SUPPLIER_ID", "p"."UPDATED_AT", "p"."UPDATED_BY", "p"."VENDOR_NAME"
    FROM "PURCHASE_ORDER" "p"
    ORDER BY "p"."ID" DESC
    OFFSET :p_0 ROWS FETCH NEXT :p_1 ROWS ONLY
) "t"
LEFT JOIN "PURCHASE_ORDER_LINE" "p0" ON "t"."ID" = "p0"."PURCHASE_ORDER_ID"
ORDER BY "t"."ID" DESC
